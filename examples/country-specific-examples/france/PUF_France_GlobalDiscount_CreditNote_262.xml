<?xml version="1.0" encoding="UTF-8"?>
<!--
    PUF France Credit Note for Global Discount (Code 262) Example

    Business Scenario:
    - B2B credit note issuing a global discount/rebate (Avoir pour Remise Globale)
    - Covers a period of invoices under a framework contract (end-of-quarter rebate)
    - Standard French mandatory elements
    - Single line item summarising the rebate amount
    - Standard VAT rate (20%)

    Code 262 specifics:
    - BT-3 CreditNoteTypeCode = 262 (Avoir pour Remise Globale)
    - BT-12 (Contract reference) is conditionally mandatory
    - BG-14 (Invoice period: BT-73 start + BT-74 end) is conditionally mandatory
    - No single preceding invoice is referenced (the credit applies globally to
      all invoices issued under the contract during the period)

    Downstream transformation (flux-specific):
    - F1 (clearance / subset to PPF) and F10.1 (e-reporting): code is remapped
      to 381, BT-12 -> BT-25 and BT-73 -> BT-26.
    - F2 (invoice transmission): code is preserved as 262.

    French Mandatory Elements:
    - BT-23: Business process type (B1 = Goods)
    - BT-34: Seller electronic address (schemeID 0225 = French e-invoicing annuaire address)
    - BT-49: Buyer electronic address (schemeID 0225 = French e-invoicing annuaire address)
    - French text codes (BT-21/BT-22):
      * #REG#: Company legal form and share capital
      * #ABL#: Trade register number (RCS)
      * #AAI#: APE business activity code
      * #PMD#: Late payment penalties
      * #PMT#: Fixed collection costs indemnity (40 EUR)
      * #BAR#: Treatment type (B2B e-invoicing)
    - SIRET identifier (BT-29)
    - French address format
-->
<CreditNote xmlns="urn:pagero:PageroUniversalFormat:CreditNote:1.0" xmlns:cac="urn:pagero:CommonAggregateComponents:1.0" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:puf="urn:pagero:ExtensionComponent:1.0" xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2">

    <!-- BT-24 Specification identifier -->
    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:ComplianceExtension</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:ComplianceExtension>
                        <!-- REGULATED (true) / NON_REGULATED (false); authoritative, equivalent to #BAR# -->
                        <puf:ComplianceActivatedIndicator>true</puf:ComplianceActivatedIndicator>
                    </puf:ComplianceExtension>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
    </ext:UBLExtensions>
    <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
    <!-- BT-23 Business process type -->
    <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
    <!-- BT-1 Credit Note Number -->
    <cbc:ID>FR-CN-2026-Q1-RG-001</cbc:ID>
    <!-- BT-2 Credit Note Issue Date -->
    <cbc:IssueDate>2026-04-15</cbc:IssueDate>
    <!-- BT-3 Credit Note Type Code - 262: Avoir pour Remise Globale (global discount credit note) -->
    <!-- @name attribute contains business process type: B1 = Goods -->
    <cbc:CreditNoteTypeCode name="B1">262</cbc:CreditNoteTypeCode>

    <!-- BT-21/BT-22: Credit Note notes with French text codes (mandatory for France) -->
    <!-- #REG#: Company legal form and share capital -->
    <cbc:Note>#REG#SARL au capital de 100000.00 EUR</cbc:Note>
    <!-- #ABL#: Legal information - Trade register -->
    <cbc:Note>#ABL#RCS Lyon B 987 654 321</cbc:Note>
    <!-- #AAI#: APE code (business activity classification) -->
    <cbc:Note>#AAI#APE 4651Z - Commerce de gros d'ordinateurs</cbc:Note>
    <!-- #PMD#: Late payment penalties (French mandatory payment terms) -->
    <cbc:Note>#PMD#En cas de retard de paiement, application des penalites a un taux egal au taux d'interet applique par la BCE majore de 10 points de pourcentage</cbc:Note>
    <!-- #PMT#: Fixed indemnity for collection costs -->
    <cbc:Note>#PMT#Indemnite forfaitaire pour frais de recouvrement en cas de retard de paiement : 40 EUR</cbc:Note>
    <!-- #BAR#: Treatment type qualification - B2B e-invoicing -->
    <cbc:Note>#BAR#B2B</cbc:Note>
    <cbc:Note>#AAB#Pas d'escompte pour paiement anticipé</cbc:Note>
    <!-- Additional note explaining the global discount -->
    <cbc:Note>Avoir pour remise globale Q1 2026 - 5% sur le volume facture sur la periode au titre du contrat CONTRAT-FR-2026-001</cbc:Note>

    <!-- BT-5 Credit Note Document Currency -->
    <cbc:DocumentCurrencyCode>EUR</cbc:DocumentCurrencyCode>

    <!-- BT-10 Buyer Reference -->
    <cbc:BuyerReference>BUYER-REF-2026-001</cbc:BuyerReference>

    <!-- BG-14 Invoicing period (BT-73 + BT-74) - Conditionally mandatory for code 262 -->
    <cac:InvoicePeriod>
        <!-- BT-73 Invoicing period start date -->
        <cbc:StartDate>2026-01-01</cbc:StartDate>
        <!-- BT-74 Invoicing period end date -->
        <cbc:EndDate>2026-03-31</cbc:EndDate>
    </cac:InvoicePeriod>

    <!-- BT-12 Contract reference - Conditionally mandatory for code 262 -->
    <cac:ContractDocumentReference>
        <cbc:ID>CONTRAT-FR-2026-001</cbc:ID>
    </cac:ContractDocumentReference>

    <!-- BG-4 Seller Information -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <!-- BT-34 Seller electronic address
                 schemeID 0225 = French e-invoicing annuaire address scheme.
                 Value is the SIREN; composite SIREN_SIRET or SIREN_SIRET_CODEROUTAGE also supported.
                 Can be set in Pagero Online. -->
            <cbc:EndpointID schemeID="0225">987654321</cbc:EndpointID>
            <!-- BT-29 SIRET identifier (mandatory for French entities) -->
            <cac:PartyIdentification>
                <cbc:ID schemeID="0009">98765432100012</cbc:ID>
            </cac:PartyIdentification>
            <!-- BT-28 Seller Trading Name -->
            <cac:PartyName>
                <cbc:Name>TechDistrib France</cbc:Name>
            </cac:PartyName>
            <!-- BG-5 Seller Address -->
            <cac:PostalAddress>
                <!-- BT-35 Street name -->
                <cbc:StreetName>12 Rue de la Republique</cbc:StreetName>
                <!-- BT-37 City -->
                <cbc:CityName>Lyon</cbc:CityName>
                <!-- BT-38 Postal code -->
                <cbc:PostalZone>69002</cbc:PostalZone>
                <!-- BT-40 Country code -->
                <cac:Country>
                    <cbc:IdentificationCode>FR</cbc:IdentificationCode>
                    <cbc:Name>France</cbc:Name>
                </cac:Country>
            </cac:PostalAddress>
            <!-- BT-31 Seller VAT identifier -->
            <cac:PartyTaxScheme>
                <cbc:CompanyID>FR12987654321</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <!-- BT-27 Seller legal registration identifier -->
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>TechDistrib France SARL</cbc:RegistrationName>
                <cbc:CompanyID schemeID="0002">987654321</cbc:CompanyID>
            </cac:PartyLegalEntity>
            <!-- BG-6 Seller Contact -->
            <cac:Contact>
                <cbc:Name>Service Commercial</cbc:Name>
                <cbc:Telephone>+33 4 72 00 00 00</cbc:Telephone>
                <cbc:ElectronicMail>commercial@techdistrib.fr</cbc:ElectronicMail>
            </cac:Contact>
        </cac:Party>
    </cac:AccountingSupplierParty>

    <!-- BG-7 Buyer Information -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <!-- BT-49 Buyer electronic address
                 schemeID 0225 = French e-invoicing annuaire address scheme. -->
            <cbc:EndpointID schemeID="0225">123456789</cbc:EndpointID>
            <!-- BT-46 Buyer identifier -->
            <cac:PartyIdentification>
                <cbc:ID schemeID="0009">12345678900034</cbc:ID>
            </cac:PartyIdentification>
            <!-- BT-45 Buyer Trading Name -->
            <cac:PartyName>
                <cbc:Name>Entreprise Client France</cbc:Name>
            </cac:PartyName>
            <!-- BG-8 Buyer Address -->
            <cac:PostalAddress>
                <!-- BT-50 Street name -->
                <cbc:StreetName>45 Avenue de la Liberte</cbc:StreetName>
                <!-- BT-52 City -->
                <cbc:CityName>Paris</cbc:CityName>
                <!-- BT-53 Postal code -->
                <cbc:PostalZone>75008</cbc:PostalZone>
                <!-- BT-55 Country code -->
                <cac:Country>
                    <cbc:IdentificationCode>FR</cbc:IdentificationCode>
                    <cbc:Name>France</cbc:Name>
                </cac:Country>
            </cac:PostalAddress>
            <!-- BT-48 Buyer VAT identifier -->
            <cac:PartyTaxScheme>
                <cbc:CompanyID>FR34123456789</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <!-- BT-44 Buyer legal registration identifier -->
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Entreprise Client France SA</cbc:RegistrationName>
                <cbc:CompanyID schemeID="0002">123456789</cbc:CompanyID>
            </cac:PartyLegalEntity>
            <!-- BG-9 Buyer Contact -->
            <cac:Contact>
                <cbc:Name>Service Comptabilite</cbc:Name>
                <cbc:Telephone>+33 1 45 00 00 00</cbc:Telephone>
                <cbc:ElectronicMail>comptabilite@client.fr</cbc:ElectronicMail>
            </cac:Contact>
        </cac:Party>
    </cac:AccountingCustomerParty>

    <!-- BG-19 Payment Instructions -->
    <cac:PaymentMeans>
        <!-- BT-81 Payment means type code - 30: Credit transfer -->
        <cbc:PaymentMeansCode>30</cbc:PaymentMeansCode>
        <!-- BT-83 Payment account identifier (IBAN) -->
        <cac:PayeeFinancialAccount>
            <cbc:ID>FR7630006000011234567890189</cbc:ID>
            <cbc:Name>TechDistrib France SARL</cbc:Name>
            <cac:FinancialInstitutionBranch>
                <!-- BT-84 Payment service provider identifier (BIC) -->
                <cbc:ID>BNPAFRPPXXX</cbc:ID>
            </cac:FinancialInstitutionBranch>
        </cac:PayeeFinancialAccount>
    </cac:PaymentMeans>

    <!-- BG-20 Payment Terms -->
    <cac:PaymentTerms>
        <!-- BT-20 Payment terms -->
        <cbc:Note>Remboursement par virement bancaire sous 30 jours</cbc:Note>
    </cac:PaymentTerms>

    <!-- BG-23 VAT Breakdown -->
    <cac:TaxTotal>
        <!-- BT-110 Credit Note total VAT amount -->
        <cbc:TaxAmount currencyID="EUR">500.00</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <!-- BT-116 VAT category taxable amount -->
            <cbc:TaxableAmount currencyID="EUR">2500.00</cbc:TaxableAmount>
            <!-- BT-117 VAT category tax amount -->
            <cbc:TaxAmount currencyID="EUR">500.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <!-- BT-118 VAT category code - S: Standard rate -->
                <cbc:ID>S</cbc:ID>
                <!-- BT-119 VAT rate - 20% standard rate in France -->
                <cbc:Percent>20.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>

    <!-- BG-22 Document Totals -->
    <cac:LegalMonetaryTotal>
        <!-- BT-106 Sum of Credit Note line net amount -->
        <cbc:LineExtensionAmount currencyID="EUR">2500.00</cbc:LineExtensionAmount>
        <!-- BT-109 Credit Note total amount without VAT -->
        <cbc:TaxExclusiveAmount currencyID="EUR">2500.00</cbc:TaxExclusiveAmount>
        <!-- BT-112 Credit Note total amount with VAT -->
        <cbc:TaxInclusiveAmount currencyID="EUR">3000.00</cbc:TaxInclusiveAmount>
        <!-- BT-115 Amount due for payment (credit amount) -->
        <cbc:PayableAmount currencyID="EUR">3000.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>

    <!-- BG-25 Credit Note Line -->
    <cac:CreditNoteLine>
        <!-- BT-126 Credit Note line identifier -->
        <cbc:ID>1</cbc:ID>
        <!-- BT-129 Credited quantity (1 lump-sum line for the global discount) -->
        <cbc:CreditedQuantity unitCode="C62">1</cbc:CreditedQuantity>
        <!-- BT-131 Credit Note line net amount -->
        <cbc:LineExtensionAmount currencyID="EUR">2500.00</cbc:LineExtensionAmount>
        <!-- BG-31 Item Information -->
        <cac:Item>
            <!-- BT-154 Item description -->
            <cbc:Description>Remise globale de 5% sur le volume facture du 01/01/2026 au 31/03/2026 au titre du contrat CONTRAT-FR-2026-001</cbc:Description>
            <!-- BT-153 Item name -->
            <cbc:Name>Remise globale Q1 2026</cbc:Name>
            <!-- BG-30 Line VAT Information -->
            <cac:ClassifiedTaxCategory>
                <!-- BT-151 Credited item VAT category code -->
                <cbc:ID>S</cbc:ID>
                <!-- BT-152 Credited item VAT rate -->
                <cbc:Percent>20.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <!-- BG-29 Price Details -->
        <cac:Price>
            <!-- BT-146 Item net price -->
            <cbc:PriceAmount currencyID="EUR">2500.00</cbc:PriceAmount>
            <!-- BT-149 Item price base quantity -->
            <cbc:BaseQuantity unitCode="C62">1</cbc:BaseQuantity>
        </cac:Price>
    </cac:CreditNoteLine>

</CreditNote>
