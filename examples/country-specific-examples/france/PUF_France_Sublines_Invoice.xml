<?xml version="1.0" encoding="UTF-8"?>
<!--
    PUF France Sub-lines Invoice Example (EXTENDED-CTC-FR)

    Business Scenario:
    - B2B goods invoice (B1) for a grouped "office furniture set"
    - One GROUP line (sub-line subtotal) with two DETAIL sub-lines and one INFORMATION line
    - Sub-lines stay FLAT; the parent pointer (puf:ParentLineID) expresses the hierarchy

    Sub-line model (XP Z12-014 - Facture Sous Ligne, UC12 pattern):
    - puf:RowType        SUMMARY (GROUP) | PLAIN (DETAIL) | INFO (INFORMATION)  -> EXT-FR-FE-163 line subtype
    - puf:ParentLineID   cbc:ID of the parent InvoiceLine in this same document  -> EXT-FR-FE-162 parent line id
    - cac:Item/cbc:PackQuantity (native UBL)                                     -> EXT-FR-FE-191 quantity per one parent unit

    Totalling (XP Z12-014 section 3.2.37):
    - Only DETAIL and standard lines are summed into the document totals (BT-106).
    - GROUP and INFORMATION lines are NOT summed (the GROUP carries the subtotal of its children).
    - GROUP and INFORMATION lines are dropped from the clearance (Flux 1) and e-reporting (Flux 10);
      the full structure is kept only in the commercial invoice (Flux 2).

    French Mandatory Elements: see PUF_France_Generic_Invoice.xml (SIRET, #REG#/#ABL#/#AAI#/#PMD#/#PMT#/#BAR#).
-->
<Invoice xmlns="urn:pagero:PageroUniversalFormat:Invoice:1.0" xmlns:cac="urn:pagero:CommonAggregateComponents:1.0" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" xmlns:puf="urn:pagero:ExtensionComponent:1.0" xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2">

    <!-- BT-24 Specification identifier -->
    <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
    <!-- BT-23 Business process type -->
    <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
    <!-- BT-1 Invoice Number -->
    <cbc:ID>FR-INV-2026-SL01</cbc:ID>
    <!-- BT-2 Invoice Issue Date -->
    <cbc:IssueDate>2026-02-01</cbc:IssueDate>
    <!-- BT-9 Payment Due Date -->
    <cbc:DueDate>2026-03-03</cbc:DueDate>
    <!-- BT-3 Invoice Type Code - 380: Commercial invoice; @name B1 = Goods invoice -->
    <cbc:InvoiceTypeCode name="B1">380</cbc:InvoiceTypeCode>

    <!-- BT-21/BT-22: Invoice notes with French text codes (mandatory for France) -->
    <cbc:Note>#REG#SARL au capital de 100000.00 EUR</cbc:Note>
    <cbc:Note>#ABL#RCS Lyon B 987 654 321</cbc:Note>
    <cbc:Note>#AAI#APE 4651Z - Commerce de gros d'ordinateurs</cbc:Note>
    <cbc:Note>#PMD#En cas de retard de paiement, application des pénalités à un taux égal au taux d'intérêt appliqué par la BCE majoré de 10 points de pourcentage</cbc:Note>
    <cbc:Note>#PMT#Indemnité forfaitaire pour frais de recouvrement en cas de retard de paiement : 40 EUR</cbc:Note>
    <cbc:Note>#BAR#B2B</cbc:Note>
    <cbc:Note>#AAB#Pas d'escompte pour paiement anticipé</cbc:Note>

    <!-- BT-5 Invoice Document Currency -->
    <cbc:DocumentCurrencyCode>EUR</cbc:DocumentCurrencyCode>

    <!-- BT-10 Buyer Reference -->
    <cbc:BuyerReference>BUYER-REF-2026-001</cbc:BuyerReference>

    <!-- BT-13 Purchase Order Reference -->
    <cac:OrderReference>
        <cbc:ID>PO-2026-FR-001</cbc:ID>
        <cbc:IssueDate>2026-01-25</cbc:IssueDate>
    </cac:OrderReference>

    <!-- BG-4 Seller Information -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <!-- BT-34 Seller electronic address (schemeID 0225 = French annuaire address, SIREN) -->
            <cbc:EndpointID schemeID="0225">987654321</cbc:EndpointID>
            <!-- BT-29 SIRET identifier -->
            <cac:PartyIdentification>
                <cbc:ID schemeID="0009">98765432100012</cbc:ID>
            </cac:PartyIdentification>
            <!-- BT-28 Seller Trading Name -->
            <cac:PartyName>
                <cbc:Name>TechDistrib France</cbc:Name>
            </cac:PartyName>
            <!-- BG-5 Seller Address -->
            <cac:PostalAddress>
                <cbc:StreetName>12 Rue de la République</cbc:StreetName>
                <cbc:CityName>Lyon</cbc:CityName>
                <cbc:PostalZone>69002</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>FR</cbc:IdentificationCode>
                    <cbc:Name>France</cbc:Name>
                </cac:Country>
            </cac:PostalAddress>
            <!-- BT-31 Seller VAT identifier -->
            <cac:PartyTaxScheme>
                <cbc:CompanyID>FR12987654321</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <!-- BT-27 Seller legal registration identifier -->
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>TechDistrib France SARL</cbc:RegistrationName>
                <cbc:CompanyID schemeID="0002">987654321</cbc:CompanyID>
            </cac:PartyLegalEntity>
            <!-- BG-6 Seller Contact -->
            <cac:Contact>
                <cbc:Name>Service Commercial</cbc:Name>
                <cbc:Telephone>+33 4 72 00 00 00</cbc:Telephone>
                <cbc:ElectronicMail>commercial@techdistrib.fr</cbc:ElectronicMail>
            </cac:Contact>
        </cac:Party>
    </cac:AccountingSupplierParty>

    <!-- BG-7 Buyer Information -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <!-- BT-49 Buyer electronic address (schemeID 0225 = French annuaire address, SIREN) -->
            <cbc:EndpointID schemeID="0225">123456789</cbc:EndpointID>
            <!-- BT-46 Buyer identifier -->
            <cac:PartyIdentification>
                <cbc:ID schemeID="0009">12345678900034</cbc:ID>
            </cac:PartyIdentification>
            <!-- BT-45 Buyer Trading Name -->
            <cac:PartyName>
                <cbc:Name>Entreprise Client France</cbc:Name>
            </cac:PartyName>
            <!-- BG-8 Buyer Address -->
            <cac:PostalAddress>
                <cbc:StreetName>45 Avenue de la Liberté</cbc:StreetName>
                <cbc:CityName>Paris</cbc:CityName>
                <cbc:PostalZone>75008</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>FR</cbc:IdentificationCode>
                    <cbc:Name>France</cbc:Name>
                </cac:Country>
            </cac:PostalAddress>
            <!-- BT-48 Buyer VAT identifier -->
            <cac:PartyTaxScheme>
                <cbc:CompanyID>FR34123456789</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <!-- BT-44 Buyer legal registration identifier -->
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Entreprise Client France SA</cbc:RegistrationName>
                <cbc:CompanyID schemeID="0002">123456789</cbc:CompanyID>
            </cac:PartyLegalEntity>
            <!-- BG-9 Buyer Contact -->
            <cac:Contact>
                <cbc:Name>Service Comptabilité</cbc:Name>
                <cbc:Telephone>+33 1 45 00 00 00</cbc:Telephone>
                <cbc:ElectronicMail>comptabilite@client.fr</cbc:ElectronicMail>
            </cac:Contact>
        </cac:Party>
    </cac:AccountingCustomerParty>

    <!-- BG-19 Payment Instructions -->
    <cac:PaymentMeans>
        <!-- BT-81 Payment means type code - 30: Credit transfer -->
        <cbc:PaymentMeansCode>30</cbc:PaymentMeansCode>
        <cac:PayeeFinancialAccount>
            <!-- BT-84 Payment account identifier (IBAN) -->
            <cbc:ID>FR7630006000011234567890189</cbc:ID>
            <cbc:Name>TechDistrib France SARL</cbc:Name>
            <cac:FinancialInstitutionBranch>
                <cbc:ID>BNPAFRPPXXX</cbc:ID>
            </cac:FinancialInstitutionBranch>
        </cac:PayeeFinancialAccount>
    </cac:PaymentMeans>

    <!-- BG-20 Payment Terms -->
    <cac:PaymentTerms>
        <cbc:Note>Paiement à 30 jours fin de mois</cbc:Note>
    </cac:PaymentTerms>

    <!-- BG-23 VAT Breakdown -->
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="EUR">200.00</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="EUR">1000.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="EUR">200.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>20.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>

    <!-- BG-22 Document Totals (GROUP and INFORMATION lines excluded; only DETAIL lines summed) -->
    <cac:LegalMonetaryTotal>
        <!-- BT-106 Sum of Invoice line net amount = 600.00 + 400.00 (DETAIL lines only) -->
        <cbc:LineExtensionAmount currencyID="EUR">1000.00</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="EUR">1000.00</cbc:TaxExclusiveAmount>
        <cbc:TaxInclusiveAmount currencyID="EUR">1200.00</cbc:TaxInclusiveAmount>
        <cbc:PayableAmount currencyID="EUR">1200.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>

    <!-- BG-25 Invoice Line 10: GROUP (sub-line subtotal) - EXT-FR-FE-163 = GROUP -->
    <!-- Carries the subtotal of its DETAIL children; excluded from BT-106 and from Flux 1 / Flux 10 -->
    <cac:InvoiceLine>
        <ext:UBLExtensions>
            <ext:UBLExtension>
                <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
                <ext:ExtensionContent>
                    <puf:PageroExtension>
                        <puf:LineExtension>
                            <!-- EXT-FR-FE-163 line subtype -->
                            <puf:RowType>SUMMARY</puf:RowType>
                        </puf:LineExtension>
                    </puf:PageroExtension>
                </ext:ExtensionContent>
            </ext:UBLExtension>
        </ext:UBLExtensions>
        <!-- BT-126 Invoice line identifier -->
        <cbc:ID>10</cbc:ID>
        <!-- BT-129 Invoiced quantity -->
        <cbc:InvoicedQuantity unitCode="H87">1</cbc:InvoicedQuantity>
        <!-- BT-131 Invoice line net amount (subtotal of DETAIL children) -->
        <cbc:LineExtensionAmount currencyID="EUR">1000.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Description>Ensemble mobilier de bureau (poste de travail complet)</cbc:Description>
            <cbc:Name>Lot mobilier de bureau</cbc:Name>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>20.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="EUR">1000.00</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="H87">1</cbc:BaseQuantity>
        </cac:Price>
    </cac:InvoiceLine>

    <!-- BG-25 Invoice Line 20: DETAIL of line 10 - EXT-FR-FE-163 = DETAIL, EXT-FR-FE-162 = 10 -->
    <cac:InvoiceLine>
        <ext:UBLExtensions>
            <ext:UBLExtension>
                <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
                <ext:ExtensionContent>
                    <puf:PageroExtension>
                        <puf:LineExtension>
                            <!-- EXT-FR-FE-163 line subtype -->
                            <puf:RowType>PLAIN</puf:RowType>
                            <!-- EXT-FR-FE-162 parent line id (references line 10) -->
                            <puf:ParentLineID>10</puf:ParentLineID>
                        </puf:LineExtension>
                    </puf:PageroExtension>
                </ext:ExtensionContent>
            </ext:UBLExtension>
        </ext:UBLExtensions>
        <cbc:ID>20</cbc:ID>
        <cbc:InvoicedQuantity unitCode="H87">2</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="EUR">600.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Description>Bureau réglable en hauteur, plateau 160x80 cm</cbc:Description>
            <!-- EXT-FR-FE-191 quantity contained in one unit of the parent line (1 desk per parent unit) -->
            <cbc:PackQuantity unitCode="H87">1</cbc:PackQuantity>
            <cbc:Name>Bureau réglable</cbc:Name>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>20.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="EUR">300.00</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="H87">1</cbc:BaseQuantity>
        </cac:Price>
    </cac:InvoiceLine>

    <!-- BG-25 Invoice Line 30: DETAIL of line 10 - EXT-FR-FE-163 = DETAIL, EXT-FR-FE-162 = 10 -->
    <cac:InvoiceLine>
        <ext:UBLExtensions>
            <ext:UBLExtension>
                <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
                <ext:ExtensionContent>
                    <puf:PageroExtension>
                        <puf:LineExtension>
                            <!-- EXT-FR-FE-163 line subtype -->
                            <puf:RowType>PLAIN</puf:RowType>
                            <!-- EXT-FR-FE-162 parent line id (references line 10) -->
                            <puf:ParentLineID>10</puf:ParentLineID>
                        </puf:LineExtension>
                    </puf:PageroExtension>
                </ext:ExtensionContent>
            </ext:UBLExtension>
        </ext:UBLExtensions>
        <cbc:ID>30</cbc:ID>
        <cbc:InvoicedQuantity unitCode="H87">6</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="EUR">400.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Description>Chaise de bureau ergonomique, lot de 6</cbc:Description>
            <!-- EXT-FR-FE-191 quantity contained in one unit of the parent line (6 chairs per parent unit) -->
            <cbc:PackQuantity unitCode="H87">6</cbc:PackQuantity>
            <cbc:Name>Chaise ergonomique</cbc:Name>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>20.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="EUR">66.67</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="H87">1</cbc:BaseQuantity>
        </cac:Price>
    </cac:InvoiceLine>

    <!-- BG-25 Invoice Line 40: INFORMATION attached to line 10 - EXT-FR-FE-163 = INFORMATION, EXT-FR-FE-162 = 10 -->
    <!-- Carries no amount in the totals; excluded from BT-106 and from Flux 1 / Flux 10 -->
    <cac:InvoiceLine>
        <ext:UBLExtensions>
            <ext:UBLExtension>
                <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
                <ext:ExtensionContent>
                    <puf:PageroExtension>
                        <puf:LineExtension>
                            <!-- EXT-FR-FE-163 line subtype -->
                            <puf:RowType>INFO</puf:RowType>
                            <!-- EXT-FR-FE-162 parent line id (references line 10) -->
                            <puf:ParentLineID>10</puf:ParentLineID>
                        </puf:LineExtension>
                    </puf:PageroExtension>
                </ext:ExtensionContent>
            </ext:UBLExtension>
        </ext:UBLExtensions>
        <cbc:ID>40</cbc:ID>
        <cbc:InvoicedQuantity unitCode="H87">0</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="EUR">0.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Description>Garantie sur site 3 ans incluse pour l'ensemble du poste de travail</cbc:Description>
            <cbc:Name>Garantie 3 ans</cbc:Name>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>20.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="EUR">0.00</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="H87">1</cbc:BaseQuantity>
        </cac:Price>
    </cac:InvoiceLine>

</Invoice>
