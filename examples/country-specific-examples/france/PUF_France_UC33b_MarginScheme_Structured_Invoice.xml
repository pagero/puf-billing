<?xml version="1.0" encoding="UTF-8"?>
<!--
    PUF Invoice Example: UC33b - Structured Travel-Agency Margin Disclosure

    Use Case: XP Z12-014 v1.4 section 3.2.32.3 option 2. The invoice exposes the
              travel-agency margin and the VAT on that margin through two additional lines.

    Country: France
    Format: PUF (Pagero Universal Format) 2.0
    Document Type: Standard Commercial Invoice (Type 380)
    Business Process: S1 (Services invoice)

    Scenario Description:
    Voyages Horizon Lyon SARL invoices EUR 300 of travel services. The invoice contains
    EUR 300 of exempt margin-scheme services, reverses the EUR 120 VAT-inclusive margin,
    then exposes EUR 100 of margin excluding VAT at 20 percent. Totals are EUR 280
    excluding VAT, EUR 20 VAT, and EUR 300 including VAT.

    Reference: XP Z12-014 Annexe A v1.4, section 3.2.32.3, option 2 and Figure 46.

    Key Fields:
    - Lines 1 and 2: category E, VATEX-EU-D, total EUR 300.
    - Line 10: REPRISE MARGE BENEFICIAIRE TTC, quantity -1, total -120.
    - Line 11: MARGE BENEFICIAIRE HT, category S at 20 percent, total 100.
    - BG-23: exempt base 180 and standard base 100 with VAT 20.

    VATEX codes for margin scheme:
    - VATEX-EU-F: Second-hand goods (Article 297 A CGI / EU VAT Directive Art. 314)
    - VATEX-EU-I: Works of art (Article 297 A CGI / EU VAT Directive Art. 316)
    - VATEX-EU-J: Collector items and antiques (Article 297 A CGI / EU VAT Directive Art. 316)
    - VATEX-EU-D: Travel-agency margin scheme (Article 266, 1(e) CGI)

    Note: VAT pre-filling by PPF will be inaccurate for margin invoices — the seller
    declares the correct margin VAT in their CA3/CA12 return.

-->
<Invoice xmlns="urn:pagero:PageroUniversalFormat:Invoice:1.0"
         xmlns:cac="urn:pagero:CommonAggregateComponents:1.0"
         xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
         xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
         xmlns:puf="urn:pagero:ExtensionComponent:1.0">

    <!-- BT-24 Specification identifier -->
    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:ComplianceExtension</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:ComplianceExtension>
                        <!-- REGULATED (true) / NON_REGULATED (false); authoritative, equivalent to #BAR# -->
                        <puf:ComplianceActivatedIndicator>true</puf:ComplianceActivatedIndicator>
                    </puf:ComplianceExtension>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
    </ext:UBLExtensions>
    <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
    <!-- BT-23 Business process type (on InvoiceTypeCode/@name) -->
    <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
    <!-- BT-1 Invoice number -->
    <cbc:ID>VHL-2026-UC33B</cbc:ID>
    <!-- BT-2 Invoice issue date -->
    <cbc:IssueDate>2026-02-10</cbc:IssueDate>
    <!-- BT-9 Payment due date -->
    <cbc:DueDate>2026-02-10</cbc:DueDate>
    <!-- BT-3 Invoice type code = 380, BT-23 = S1 (services invoice) -->
    <cbc:InvoiceTypeCode name="S1">380</cbc:InvoiceTypeCode>

    <!-- BT-22/BT-21: French mandatory text codes -->
    <cbc:Note>#REG#SARL au capital de 80 000 EUR — RCS Lyon B 654 321 987 — SIRET 65432198711100</cbc:Note>
    <cbc:Note>#ABL#RCS Lyon B 654 321 987</cbc:Note>
    <cbc:Note>#AAI#APE 7911Z — Activités des agences de voyage</cbc:Note>
    <cbc:Note>#PMD#En cas de retard de paiement, pénalités au taux BCE + 10 points et indemnité forfaitaire de recouvrement de 40 EUR</cbc:Note>
    <cbc:Note>#PMT#Paiement comptant à la fourniture des prestations</cbc:Note>
    <cbc:Note>#BAR#B2B</cbc:Note>
    <cbc:Note>#AAB#Pas d'escompte pour paiement anticipé</cbc:Note>
    <!--
        Travel-agency margin-scheme notice for Article 266, 1(e) CGI.
    -->
    <cbc:Note>#AAI#RÉGIME PARTICULIER — Agences de voyage — Article 266, 1-e du Code général des impôts.</cbc:Note>

    <!-- BT-5 Invoice currency -->
    <cbc:DocumentCurrencyCode>EUR</cbc:DocumentCurrencyCode>

    <!-- BT-10 Buyer reference -->
    <cbc:BuyerReference>TRAVEL-2026-0032</cbc:BuyerReference>

    <!-- BG-4 Seller — Travel agency -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <cbc:EndpointID schemeID="0225">65432198711100</cbc:EndpointID>
            <cac:PartyIdentification>
                <cbc:ID schemeID="0009">65432198711100</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name>Voyages Horizon Lyon</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>Route de Vienne, ZA Les Portes du Sud</cbc:StreetName>
                <cbc:CityName>Vénissieux</cbc:CityName>
                <cbc:PostalZone>69200</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>FR</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>FR65654321987</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Voyages Horizon Lyon SARL</cbc:RegistrationName>
                <cbc:CompanyID schemeID="0002">654321987</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingSupplierParty>

    <!-- BG-7 Buyer — Corporate travel customer -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <cbc:EndpointID schemeID="0225">31415926535897</cbc:EndpointID>
            <cac:PartyIdentification>
                <cbc:ID schemeID="0009">31415926535897</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name>Entreprise Cliente Rhône</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>5 Rue des Voyageurs</cbc:StreetName>
                <cbc:CityName>Villeurbanne</cbc:CityName>
                <cbc:PostalZone>69100</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>FR</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>FR31314159265</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Entreprise Cliente Rhône SAS</cbc:RegistrationName>
                <cbc:CompanyID schemeID="0002">314159265</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingCustomerParty>

    <!-- BG-19 Payment instructions -->
    <cac:PaymentMeans>
        <cbc:PaymentMeansCode>30</cbc:PaymentMeansCode>
        <cac:PayeeFinancialAccount>
            <cbc:ID>FR7630002000981234500000067</cbc:ID>
            <cbc:Name>Voyages Horizon Lyon SARL</cbc:Name>
            <cac:FinancialInstitutionBranch>
                <cbc:ID>SOGEFRPP</cbc:ID>
            </cac:FinancialInstitutionBranch>
        </cac:PayeeFinancialAccount>
    </cac:PaymentMeans>

    <!-- BG-23 VAT Breakdown for the structured margin disclosure -->
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="EUR">20.00</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="EUR">180.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="EUR">0.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>E</cbc:ID>
                <cbc:Percent>0.00</cbc:Percent>
                <cbc:TaxExemptionReasonCode>VATEX-EU-D</cbc:TaxExemptionReasonCode>
                <cbc:TaxExemptionReason>Régime particulier — Agences de voyage</cbc:TaxExemptionReason>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="EUR">100.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="EUR">20.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>20.00</cbc:Percent>
                <cbc:TaxExemptionReasonCode>VATEX-EU-D</cbc:TaxExemptionReasonCode>
                <cbc:TaxExemptionReason>Régime particulier — Agences de voyage — MARGE BENEFICIAIRE</cbc:TaxExemptionReason>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>

    <!-- BG-22 Document totals -->
    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="EUR">280.00</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="EUR">280.00</cbc:TaxExclusiveAmount>
        <cbc:TaxInclusiveAmount currencyID="EUR">300.00</cbc:TaxInclusiveAmount>
        <cbc:PayableAmount currencyID="EUR">300.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>

    <!-- BG-25 Line 1 — Travel service subject to the margin scheme -->
    <cac:InvoiceLine>
        <cbc:ID>1</cbc:ID>
        <cbc:InvoicedQuantity unitCode="C62">1</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="EUR">160.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Description>Travel service component 1</cbc:Description>
            <cbc:Name>Article 1</cbc:Name>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>E</cbc:ID>
                <cbc:Percent>0.00</cbc:Percent>
                <cbc:TaxExemptionReasonCode>VATEX-EU-D</cbc:TaxExemptionReasonCode>
                <cbc:TaxExemptionReason>Régime particulier — Agences de voyage</cbc:TaxExemptionReason>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="EUR">160.00</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="C62">1</cbc:BaseQuantity>
        </cac:Price>
    </cac:InvoiceLine>

    <cac:InvoiceLine>
        <cbc:ID>2</cbc:ID>
        <cbc:InvoicedQuantity unitCode="C62">4</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="EUR">140.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Description>Travel service component 2</cbc:Description>
            <cbc:Name>Article 2</cbc:Name>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>E</cbc:ID>
                <cbc:Percent>0.00</cbc:Percent>
                <cbc:TaxExemptionReasonCode>VATEX-EU-D</cbc:TaxExemptionReasonCode>
                <cbc:TaxExemptionReason>Régime particulier — Agences de voyage</cbc:TaxExemptionReason>
                <cac:TaxScheme><cbc:ID>VAT</cbc:ID></cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="EUR">35.00</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="C62">1</cbc:BaseQuantity>
        </cac:Price>
    </cac:InvoiceLine>

    <cac:InvoiceLine>
        <cbc:ID>10</cbc:ID>
        <cbc:InvoicedQuantity unitCode="C62">-1</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="EUR">-120.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Name>REPRISE MARGE BENEFICIAIRE TTC</cbc:Name>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>E</cbc:ID>
                <cbc:Percent>0.00</cbc:Percent>
                <cbc:TaxExemptionReasonCode>VATEX-EU-D</cbc:TaxExemptionReasonCode>
                <cbc:TaxExemptionReason>Régime particulier — Agences de voyage</cbc:TaxExemptionReason>
                <cac:TaxScheme><cbc:ID>VAT</cbc:ID></cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="EUR">120.00</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="C62">1</cbc:BaseQuantity>
        </cac:Price>
    </cac:InvoiceLine>

    <cac:InvoiceLine>
        <cbc:ID>11</cbc:ID>
        <cbc:InvoicedQuantity unitCode="C62">1</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="EUR">100.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Name>MARGE BENEFICIAIRE HT</cbc:Name>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>20.00</cbc:Percent>
                <cbc:TaxExemptionReasonCode>VATEX-EU-D</cbc:TaxExemptionReasonCode>
                <cbc:TaxExemptionReason>Régime particulier — Agences de voyage — MARGE BENEFICIAIRE</cbc:TaxExemptionReason>
                <cac:TaxScheme><cbc:ID>VAT</cbc:ID></cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="EUR">100.00</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="C62">1</cbc:BaseQuantity>
        </cac:Price>
    </cac:InvoiceLine>

</Invoice>
