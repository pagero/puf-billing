<?xml version="1.0" encoding="UTF-8"?>
<!--
    PUF France Energy-Sector Invoice Example (EXTENDED-CTC-FR) - XP Z12-014 v1.4 section 3.3.2

    Business Scenario:
    - B2B electricity supply invoice (UFE energy-sector bonne pratique)
    - One consumption line carrying:
        * BT-128 line object identifier with MULTIPLE UNTDID-1153 qualifiers
          (energy 0..n; EXTENDED-CTC-FR only) via repeated cac:DocumentReference
        * BG-32 harmonised article attributes (BT-160 name / BT-161 value):
          NUMERO_COMPTEUR, INDEX_DEBUT, INDEX_FIN, PUISSANCE SOUSCRITE, COEFFICIENT_PTA

        Pipeline support:
        - The internal->France EXTENDED transform preserves all line-level BT-128 qualifiers.
            This example exercises that 0..n mapping with multiple identifiers.
-->
<Invoice xmlns="urn:pagero:PageroUniversalFormat:Invoice:1.0" xmlns:cac="urn:pagero:CommonAggregateComponents:1.0" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" xmlns:puf="urn:pagero:ExtensionComponent:1.0" xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2">

    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:ComplianceExtension</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:ComplianceExtension>
                        <!-- REGULATED (true) / NON_REGULATED (false); authoritative, equivalent to #BAR# -->
                        <puf:ComplianceActivatedIndicator>true</puf:ComplianceActivatedIndicator>
                    </puf:ComplianceExtension>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
    </ext:UBLExtensions>
    <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
    <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
    <!-- BT-1 Invoice Number -->
    <cbc:ID>FR-INV-2026-UC38</cbc:ID>
    <!-- BT-2 Invoice Issue Date -->
    <cbc:IssueDate>2026-02-01</cbc:IssueDate>
    <!-- BT-9 Payment Due Date -->
    <cbc:DueDate>2026-03-03</cbc:DueDate>
    <!-- BT-3 Invoice Type Code - 380; @name B1 = Goods invoice (electricity) -->
    <cbc:InvoiceTypeCode name="B1">380</cbc:InvoiceTypeCode>

    <!-- French mandatory legal-mention notes -->
    <cbc:Note>#REG#SA au capital de 900000.00 EUR</cbc:Note>
    <cbc:Note>#ABL#RCS Paris B 552 081 317</cbc:Note>
    <cbc:Note>#AAI#APE 3514Z - Commerce d'électricité</cbc:Note>
    <cbc:Note>#PMD#En cas de retard de paiement, application des pénalités à un taux égal au taux d'intérêt appliqué par la BCE majoré de 10 points de pourcentage</cbc:Note>
    <cbc:Note>#PMT#Indemnité forfaitaire pour frais de recouvrement en cas de retard de paiement : 40 EUR</cbc:Note>
    <cbc:Note>#BAR#B2B</cbc:Note>
    <cbc:Note>#AAB#Pas d'escompte pour paiement anticipé</cbc:Note>

    <cbc:DocumentCurrencyCode>EUR</cbc:DocumentCurrencyCode>
    <cbc:BuyerReference>BUYER-REF-2026-UC38</cbc:BuyerReference>

    <!-- BG-4 Seller Information (energy supplier) -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <cbc:EndpointID schemeID="0225">552081317</cbc:EndpointID>
            <cac:PartyIdentification>
                <cbc:ID schemeID="0009">55208131700025</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name>Énergie Nationale</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>1 Place des Énergies</cbc:StreetName>
                <cbc:CityName>Paris</cbc:CityName>
                <cbc:PostalZone>75008</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>FR</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>FR55552081317</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Énergie Nationale SA</cbc:RegistrationName>
                <cbc:CompanyID schemeID="0002">552081317</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingSupplierParty>

    <!-- BG-7 Buyer Information -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <cbc:EndpointID schemeID="0225">123456789</cbc:EndpointID>
            <cac:PartyIdentification>
                <cbc:ID schemeID="0009">12345678900034</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name>Usine Client France</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>45 Avenue de la Liberté</cbc:StreetName>
                <cbc:CityName>Paris</cbc:CityName>
                <cbc:PostalZone>75008</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>FR</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>FR34123456789</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Usine Client France SA</cbc:RegistrationName>
                <cbc:CompanyID schemeID="0002">123456789</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingCustomerParty>

    <cac:PaymentMeans>
        <cbc:PaymentMeansCode>30</cbc:PaymentMeansCode>
        <cac:PayeeFinancialAccount>
            <cbc:ID>FR7630006000011234567890189</cbc:ID>
            <cbc:Name>Énergie Nationale SA</cbc:Name>
        </cac:PayeeFinancialAccount>
    </cac:PaymentMeans>

    <!-- BG-23 VAT Breakdown -->
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="EUR">200.00</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="EUR">1000.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="EUR">200.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>20.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>

    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="EUR">1000.00</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="EUR">1000.00</cbc:TaxExclusiveAmount>
        <cbc:TaxInclusiveAmount currencyID="EUR">1200.00</cbc:TaxInclusiveAmount>
        <cbc:PayableAmount currencyID="EUR">1200.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>

    <!-- BG-25 Invoice Line: electricity consumption over a reading period -->
    <cac:InvoiceLine>
        <cbc:ID>1</cbc:ID>
        <cbc:InvoicedQuantity unitCode="KWH">5200</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="EUR">1000.00</cbc:LineExtensionAmount>
        <!-- BT-128 line object identifiers with multiple UNTDID-1153 qualifiers (energy 0..n, EXTENDED-CTC-FR only) -->
        <!-- ACD = additional reference; AWA = delivery point / PDL -->
        <cac:DocumentReference>
            <cbc:ID schemeID="ACD">PRM-30001610071843</cbc:ID>
        </cac:DocumentReference>
        <cac:DocumentReference>
            <cbc:ID schemeID="AWA">PDL-09511696632582</cbc:ID>
        </cac:DocumentReference>
        <cac:Item>
            <cbc:Description>Fourniture d'électricité - Tarif Bleu - période du 01/01/2026 au 31/01/2026</cbc:Description>
            <cbc:Name>Électricité (kWh)</cbc:Name>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>20.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
            <!-- BG-32 harmonised energy article attributes (BT-160 name / BT-161 value) -->
            <cac:AdditionalItemProperty>
                <cbc:Name>NUMERO_COMPTEUR</cbc:Name>
                <cbc:Value>EV-32800-SM</cbc:Value>
            </cac:AdditionalItemProperty>
            <cac:AdditionalItemProperty>
                <cbc:Name>INDEX_DEBUT</cbc:Name>
                <cbc:Value>32800</cbc:Value>
            </cac:AdditionalItemProperty>
            <cac:AdditionalItemProperty>
                <cbc:Name>INDEX_FIN</cbc:Name>
                <cbc:Value>38000</cbc:Value>
            </cac:AdditionalItemProperty>
            <cac:AdditionalItemProperty>
                <cbc:Name>PUISSANCE SOUSCRITE</cbc:Name>
                <cbc:Value>36 kVA</cbc:Value>
            </cac:AdditionalItemProperty>
            <cac:AdditionalItemProperty>
                <cbc:Name>COEFFICIENT_PTA</cbc:Name>
                <cbc:Value>1.00</cbc:Value>
            </cac:AdditionalItemProperty>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="EUR">0.192307</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="KWH">1</cbc:BaseQuantity>
        </cac:Price>
    </cac:InvoiceLine>

</Invoice>
