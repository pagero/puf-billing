<?xml version="1.0" encoding="UTF-8"?>
<!--
    PUF France Octroi de mer Invoice Example (EXTENDED-CTC-FR) - XP Z12-014 v1.4 section 3.2.43.2

    Business Scenario:
    - B2B goods invoice delivered to an overseas territory (DROM - Réunion), subject to octroi de mer.
    - Line-level harmonised attributes BT-160 = OM_REFNC / OM_TAUX (value in BT-161).
    - Document-level non-VAT charge block for octroi de mer:
        BT-104 (reason) = OCTROI_MER, BT-102 category = "O", carried with tax scheme "IMP" / list 5153.

    Known pipeline notes (XP Z12-014 v1.4 technical impact) - expected gaps on the internal->France leg:
    - internal 'taxNameType' is a closed enum without IMP, and the France transform hard-codes TaxScheme=VAT,
      so the BT-177="IMP"/5153 coding cannot currently be emitted (charge rides as free-text BT-104).
    - EXT-FR-FE-189 (OCTROI_MER) / EXT-FR-FE-190 (VATEX_EU-O) dedicated breakdown line has no internal carrier yet.
    The line-level OM_REFNC/OM_TAUX attributes and the VATEX-EU-O exemption DO flow end to end.
-->
<Invoice xmlns="urn:pagero:PageroUniversalFormat:Invoice:1.0" xmlns:cac="urn:pagero:CommonAggregateComponents:1.0" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" xmlns:puf="urn:pagero:ExtensionComponent:1.0" xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2">

    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:ComplianceExtension</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:ComplianceExtension>
                        <!-- REGULATED (true) / NON_REGULATED (false); authoritative, equivalent to #BAR# -->
                        <puf:ComplianceActivatedIndicator>true</puf:ComplianceActivatedIndicator>
                    </puf:ComplianceExtension>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
    </ext:UBLExtensions>
    <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
    <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
    <cbc:ID>FR-INV-2026-UC44</cbc:ID>
    <cbc:IssueDate>2026-02-01</cbc:IssueDate>
    <cbc:DueDate>2026-03-03</cbc:DueDate>
    <cbc:InvoiceTypeCode name="B1">380</cbc:InvoiceTypeCode>

    <cbc:Note>#REG#SAS au capital de 250000.00 EUR</cbc:Note>
    <cbc:Note>#ABL#RCS Saint-Denis B 444 555 666</cbc:Note>
    <cbc:Note>#AAI#APE 4634Z - Commerce de gros de boissons</cbc:Note>
    <cbc:Note>#PMD#En cas de retard de paiement, application des pénalités à un taux égal au taux d'intérêt appliqué par la BCE majoré de 10 points de pourcentage</cbc:Note>
    <cbc:Note>#PMT#Indemnité forfaitaire pour frais de recouvrement en cas de retard de paiement : 40 EUR</cbc:Note>
    <cbc:Note>#BAR#B2B</cbc:Note>
    <cbc:Note>#AAB#Pas d'escompte pour paiement anticipé</cbc:Note>

    <cbc:DocumentCurrencyCode>EUR</cbc:DocumentCurrencyCode>
    <cbc:BuyerReference>BUYER-REF-2026-UC44</cbc:BuyerReference>

    <!-- BG-4 Seller (producer, turnover > 550k EUR, established in Réunion) -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <cbc:EndpointID schemeID="0225">444555666</cbc:EndpointID>
            <cac:PartyIdentification>
                <cbc:ID schemeID="0009">44455566600028</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name>Production Réunion</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>10 Rue de l'Océan</cbc:StreetName>
                <cbc:CityName>Saint-Denis</cbc:CityName>
                <cbc:PostalZone>97400</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>FR</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>FR44444555666</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Production Réunion SAS</cbc:RegistrationName>
                <cbc:CompanyID schemeID="0002">444555666</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingSupplierParty>

    <!-- BG-7 Buyer (another taxable person in the same DROM) -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <cbc:EndpointID schemeID="0225">777888999</cbc:EndpointID>
            <cac:PartyIdentification>
                <cbc:ID schemeID="0009">77788899900010</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name>Distribution Océan Indien</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>25 Avenue de la Plage</cbc:StreetName>
                <cbc:CityName>Saint-Pierre</cbc:CityName>
                <cbc:PostalZone>97410</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>FR</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>FR77777888999</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Distribution Océan Indien SARL</cbc:RegistrationName>
                <cbc:CompanyID schemeID="0002">777888999</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingCustomerParty>

    <cac:PaymentMeans>
        <cbc:PaymentMeansCode>30</cbc:PaymentMeansCode>
        <cac:PayeeFinancialAccount>
            <cbc:ID>FR7630006000011234567890189</cbc:ID>
            <cbc:Name>Production Réunion SAS</cbc:Name>
        </cac:PayeeFinancialAccount>
    </cac:PaymentMeans>

    <!-- BG-21 Document-level charge: octroi de mer (non-VAT, category O). BT-104 reason = OCTROI_MER -->
    <cac:AllowanceCharge>
        <cbc:ChargeIndicator>true</cbc:ChargeIndicator>
        <cbc:AllowanceChargeReason>OCTROI_MER</cbc:AllowanceChargeReason>
        <cbc:Amount currencyID="EUR">28.00</cbc:Amount>
        <cac:TaxCategory>
            <!-- BT-102 = O (not subject to VAT) ; tax scheme carried as IMP / list 5153 (BT-177 / BT-177-1) -->
            <cbc:ID>O</cbc:ID>
            <cac:TaxScheme>
                <cbc:ID schemeID="UNCL5153">IMP</cbc:ID>
            </cac:TaxScheme>
        </cac:TaxCategory>
    </cac:AllowanceCharge>

    <!-- BG-23 VAT Breakdown: standard-rated goods (S) + octroi charge out of scope (O / VATEX-EU-O) -->
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="EUR">34.00</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="EUR">400.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="EUR">34.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>8.50</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="EUR">28.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="EUR">0.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>O</cbc:ID>
                <cbc:TaxExemptionReasonCode>VATEX-EU-O</cbc:TaxExemptionReasonCode>
                <cbc:TaxExemptionReason>Hors champ de la TVA - octroi de mer</cbc:TaxExemptionReason>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>

    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="EUR">400.00</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="EUR">428.00</cbc:TaxExclusiveAmount>
        <cbc:TaxInclusiveAmount currencyID="EUR">462.00</cbc:TaxInclusiveAmount>
        <cbc:ChargeTotalAmount currencyID="EUR">28.00</cbc:ChargeTotalAmount>
        <cbc:PayableAmount currencyID="EUR">462.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>

    <!-- BG-25 Invoice Line: goods, with line-level octroi attributes OM_REFNC / OM_TAUX (BT-160/161) -->
    <cac:InvoiceLine>
        <cbc:ID>1</cbc:ID>
        <cbc:InvoicedQuantity unitCode="H87">100</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="EUR">400.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Description>Boissons produites localement - lot de 100 unités</cbc:Description>
            <cbc:Name>Boisson locale</cbc:Name>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>8.50</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
            <cac:AdditionalItemProperty>
                <cbc:Name>OM_REFNC</cbc:Name>
                <cbc:Value>2208.90</cbc:Value>
            </cac:AdditionalItemProperty>
            <cac:AdditionalItemProperty>
                <cbc:Name>OM_TAUX</cbc:Name>
                <cbc:Value>7.00</cbc:Value>
            </cac:AdditionalItemProperty>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="EUR">4.00</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="H87">1</cbc:BaseQuantity>
        </cac:Price>
    </cac:InvoiceLine>

</Invoice>
