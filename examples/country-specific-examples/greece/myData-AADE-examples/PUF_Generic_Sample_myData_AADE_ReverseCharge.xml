<?xml version="1.0" encoding="UTF-8"?>
<!--
Customer: Generic
Format type: PUF
Direction: Ext to Int
Case for build: Greece myData/AADE reporting data - reverse charge / intra-community supply
-->
<Invoice xmlns="urn:pagero:PageroUniversalFormat:Invoice:1.0"
         xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
         xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
         xmlns:cac="urn:pagero:CommonAggregateComponents:1.0"
         xmlns:puf="urn:pagero:ExtensionComponent:1.0">
  <ext:UBLExtensions>

    <!-- Document-level myData/AADE header data (EL-BG-1) -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>

          <!-- Invoice series as registered with AADE (EL-BT-30, myDATA field: series) -->
          <puf:RestrictedInformation>
            <puf:Key>myDATA_XML_series</puf:Key>
            <puf:Value>0</puf:Value>
          </puf:RestrictedInformation>

          <!-- Invoice serial number within the series (EL-BT-31, myDATA field: aa) -->
          <puf:RestrictedInformation>
            <puf:Key>myDATA_XML_aa</puf:Key>
            <puf:Value>100004</puf:Value>
          </puf:RestrictedInformation>

          <!-- myDATA invoice type code: 1.2 Sales Invoice / Intra-community Supplies (EL-BT-8) -->
          <puf:RestrictedInformation>
            <puf:Key>myDATA_XML_invoiceType</puf:Key>
            <puf:Value>1.2</puf:Value>
          </puf:RestrictedInformation>

          <!-- myData payment method (EL-BG-5): code and amount for the first payment method on the document -->
          <puf:RestrictedInformation>
            <puf:Key>myDATA_XML_paymentType_1</puf:Key>
            <puf:Value>5</puf:Value>
          </puf:RestrictedInformation>
          <puf:RestrictedInformation>
            <puf:Key>myDATA_XML_paymentAmount_1</puf:Key>
            <puf:Value>1000.00</puf:Value>
          </puf:RestrictedInformation>

          <!-- myData document totals (EL-BG-4): net value, VAT amount, gross value -->
          <puf:RestrictedInformation>
            <puf:Key>myDATA_XML_totalNetValue</puf:Key>
            <puf:Value>1000.00</puf:Value>
          </puf:RestrictedInformation>
          <puf:RestrictedInformation>
            <puf:Key>myDATA_XML_totalVatAmount</puf:Key>
            <puf:Value>0.00</puf:Value>
          </puf:RestrictedInformation>
          <puf:RestrictedInformation>
            <puf:Key>myDATA_XML_totalGrossValue</puf:Key>
            <puf:Value>1000.00</puf:Value>
          </puf:RestrictedInformation>

        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>

    <!-- Line-level myData/AADE reporting data (EL-BT-39) -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformationLine</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>

          <!-- cbc:ID matches the corresponding cac:InvoiceLine/cbc:ID (EL-BT-37) -->
          <puf:RestrictedInformationLine>
            <puf:Key>myDATA_XML</puf:Key>
            <cbc:ID>1</cbc:ID>
            <!-- Line net amount -->
            <cbc:LineExtensionAmount currencyID="EUR">1000.00</cbc:LineExtensionAmount>
            <cac:TaxTotal>
              <!-- Line VAT amount (EL-BT-36): zero, reverse charge -->
              <cbc:TaxAmount currencyID="EUR">0.00</cbc:TaxAmount>
              <cac:TaxSubtotal>
                <cbc:TaxableAmount currencyID="EUR">1000.00</cbc:TaxableAmount>
                <cbc:TaxAmount currencyID="EUR">0.00</cbc:TaxAmount>
                <cac:TaxCategory>
                  <!-- Numeric AADE VAT category code (EL-BT-29): 7 = Without VAT (0%) -->
                  <cbc:ID>7</cbc:ID>
                  <cbc:Percent>0</cbc:Percent>
                  <!-- Numeric AADE VAT exemption cause code: 14 = "Without VAT - article 28 of the VAT Code" (intra-community supply of goods). Mandatory whenever the AADE VAT category is 7. -->
                  <cbc:TaxExemptionReasonCode>14</cbc:TaxExemptionReasonCode>
                  <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                  </cac:TaxScheme>
                </cac:TaxCategory>
              </cac:TaxSubtotal>
            </cac:TaxTotal>
            <!-- AADE income/expense classification for this line (EL-BT-38 income / EL-BT-52 expense) -->
            <puf:Classification>
              <puf:Type>INCOME</puf:Type>
              <puf:ClassificationType>E3_561_005</puf:ClassificationType>
              <puf:ClassificationCategory>CATEGORY1_1</puf:ClassificationCategory>
              <puf:Amount currencyID="EUR">1000.00</puf:Amount>
            </puf:Classification>
          </puf:RestrictedInformationLine>

        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>

    <!-- Document-level income/expense classification summary (EL-BT-38 / EL-BT-52) -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:Classification</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:Classification>
            <puf:Type>INCOME</puf:Type>
            <puf:ClassificationType>E3_561_005</puf:ClassificationType>
            <puf:ClassificationCategory>CATEGORY1_1</puf:ClassificationCategory>
            <puf:Amount currencyID="EUR">1000.00</puf:Amount>
          </puf:Classification>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>

  </ext:UBLExtensions>

  <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
  <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
  <!-- Invoice number (BT-1) -->
  <cbc:ID>EXAMPLE-INV-0004</cbc:ID>
  <!-- Issue date (BT-2) -->
  <cbc:IssueDate>2026-09-01</cbc:IssueDate>
  <!-- Payment due date (BT-9) -->
  <cbc:DueDate>2026-10-01</cbc:DueDate>
  <!-- Invoice type code (BT-3) -->
  <cbc:InvoiceTypeCode>380</cbc:InvoiceTypeCode>
  <!-- Value added tax point date (BT-7) -->
  <cbc:TaxPointDate>2026-09-01</cbc:TaxPointDate>
  <!-- Invoice currency code (BT-5) -->
  <cbc:DocumentCurrencyCode>EUR</cbc:DocumentCurrencyCode>
  <!-- VAT accounting currency code (BT-6) -->
  <cbc:TaxCurrencyCode>EUR</cbc:TaxCurrencyCode>

  <!-- Seller (BG-4) -->
  <cac:AccountingSupplierParty>
    <cac:Party>
      <!-- Seller electronic address (BT-34) -->
      <cbc:EndpointID schemeID="9933">100000000</cbc:EndpointID>
      <cac:PartyIdentification>
        <!-- Seller identifier (BT-29) -->
        <cbc:ID schemeID="9933">100000000</cbc:ID>
      </cac:PartyIdentification>
      <cac:PartyName>
        <!-- Seller trading name (BT-28) -->
        <cbc:Name>Example Seller SA</cbc:Name>
      </cac:PartyName>
      <cac:PostalAddress>
        <!-- Seller address line 1 (BT-35) -->
        <cbc:StreetName>Example Street 1</cbc:StreetName>
        <!-- Seller city (BT-37) -->
        <cbc:CityName>ATHENS</cbc:CityName>
        <!-- Seller post code (BT-38) -->
        <cbc:PostalZone>10000</cbc:PostalZone>
        <cac:Country>
          <!-- Seller country code (BT-40) -->
          <cbc:IdentificationCode>GR</cbc:IdentificationCode>
          <cbc:Name>Greece</cbc:Name>
        </cac:Country>
      </cac:PostalAddress>
      <cac:PartyTaxScheme>
        <!-- Seller VAT identifier (BT-31) -->
        <cbc:CompanyID>EL100000000</cbc:CompanyID>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:PartyTaxScheme>
      <cac:PartyLegalEntity>
        <!-- Seller name (BT-27) -->
        <cbc:RegistrationName>Example Seller SA</cbc:RegistrationName>
      </cac:PartyLegalEntity>
    </cac:Party>
  </cac:AccountingSupplierParty>

  <!-- Buyer (BG-7): registered in another EU member state -->
  <cac:AccountingCustomerParty>
    <cac:Party>
      <!-- Buyer electronic address (BT-49) -->
      <cbc:EndpointID schemeID="9930">DE300000000</cbc:EndpointID>
      <cac:PartyIdentification>
        <!-- Buyer identifier (BT-46) -->
        <cbc:ID schemeID="9930">DE300000000</cbc:ID>
      </cac:PartyIdentification>
      <cac:PartyName>
        <!-- Buyer trading name (BT-45) -->
        <cbc:Name>Example Buyer GmbH</cbc:Name>
      </cac:PartyName>
      <cac:PostalAddress>
        <!-- Buyer address line 1 (BT-50) -->
        <cbc:StreetName>Example Strasse 3</cbc:StreetName>
        <!-- Buyer city (BT-52) -->
        <cbc:CityName>BERLIN</cbc:CityName>
        <!-- Buyer post code (BT-53) -->
        <cbc:PostalZone>10115</cbc:PostalZone>
        <cac:Country>
          <!-- Buyer country code (BT-55) -->
          <cbc:IdentificationCode>DE</cbc:IdentificationCode>
          <cbc:Name>Germany</cbc:Name>
        </cac:Country>
      </cac:PostalAddress>
      <cac:PartyTaxScheme>
        <!-- Buyer VAT identifier (BT-48) -->
        <cbc:CompanyID>DE300000000</cbc:CompanyID>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:PartyTaxScheme>
      <cac:PartyLegalEntity>
        <!-- Buyer name (BT-44) -->
        <cbc:RegistrationName>Example Buyer GmbH</cbc:RegistrationName>
      </cac:PartyLegalEntity>
    </cac:Party>
  </cac:AccountingCustomerParty>

  <!-- Payment instructions (BG-16) -->
  <cac:PaymentMeans>
    <!-- Payment means type code (BT-81) -->
    <cbc:PaymentMeansCode>58</cbc:PaymentMeansCode>
  </cac:PaymentMeans>

  <!-- VAT breakdown (BG-23) -->
  <cac:TaxTotal>
    <!-- Invoice total VAT amount (BT-110) -->
    <cbc:TaxAmount currencyID="EUR">0.00</cbc:TaxAmount>
    <cac:TaxSubtotal>
      <!-- VAT category taxable amount (BT-116) -->
      <cbc:TaxableAmount currencyID="EUR">1000.00</cbc:TaxableAmount>
      <!-- VAT category tax amount (BT-117) -->
      <cbc:TaxAmount currencyID="EUR">0.00</cbc:TaxAmount>
      <cac:TaxCategory>
        <!-- VAT category code (BT-118): AE = VAT Reverse Charge -->
        <cbc:ID>AE</cbc:ID>
        <!-- VAT category rate (BT-119) -->
        <cbc:Percent>0</cbc:Percent>
        <!-- VAT exemption reason code (BT-121): 14 = intra-community supply of goods, mandatory whenever the AADE VAT category (line-level, EL-BT-29) is 7 -->
        <cbc:TaxExemptionReasonCode>14</cbc:TaxExemptionReasonCode>
        <!-- VAT exemption reason text (BT-120) -->
        <cbc:TaxExemptionReason>Without VAT - article 28 of the VAT Code (intra-community supply of goods)</cbc:TaxExemptionReason>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:TaxCategory>
    </cac:TaxSubtotal>
  </cac:TaxTotal>

  <!-- Document totals (BG-22) -->
  <cac:LegalMonetaryTotal>
    <!-- Sum of Invoice line net amount (BT-106) -->
    <cbc:LineExtensionAmount currencyID="EUR">1000.00</cbc:LineExtensionAmount>
    <!-- Invoice total amount without VAT (BT-109) -->
    <cbc:TaxExclusiveAmount currencyID="EUR">1000.00</cbc:TaxExclusiveAmount>
    <!-- Invoice total amount with VAT (BT-112) -->
    <cbc:TaxInclusiveAmount currencyID="EUR">1000.00</cbc:TaxInclusiveAmount>
    <!-- Amount due for payment (BT-115) -->
    <cbc:PayableAmount currencyID="EUR">1000.00</cbc:PayableAmount>
  </cac:LegalMonetaryTotal>

  <!-- Invoice line (BG-25) -->
  <cac:InvoiceLine>
    <!-- Invoice line identifier (BT-126) -->
    <cbc:ID>1</cbc:ID>
    <!-- Invoiced quantity (BT-129), unit of measure code (BT-130) -->
    <cbc:InvoicedQuantity unitCode="EA">1</cbc:InvoicedQuantity>
    <!-- Invoice line net amount (BT-131) -->
    <cbc:LineExtensionAmount currencyID="EUR">1000.00</cbc:LineExtensionAmount>
    <cac:TaxTotal>
      <cbc:TaxAmount currencyID="EUR">0.00</cbc:TaxAmount>
      <cac:TaxSubtotal>
        <cbc:TaxableAmount currencyID="EUR">1000.00</cbc:TaxableAmount>
        <cbc:TaxAmount currencyID="EUR">0.00</cbc:TaxAmount>
        <cac:TaxCategory>
          <cbc:ID>AE</cbc:ID>
          <cbc:Percent>0</cbc:Percent>
          <cbc:TaxExemptionReasonCode>14</cbc:TaxExemptionReasonCode>
          <cbc:TaxExemptionReason>Without VAT - article 28 of the VAT Code (intra-community supply of goods)</cbc:TaxExemptionReason>
          <cac:TaxScheme>
            <cbc:ID>VAT</cbc:ID>
          </cac:TaxScheme>
        </cac:TaxCategory>
      </cac:TaxSubtotal>
    </cac:TaxTotal>
    <cac:Item>
      <!-- Item description (BT-154) -->
      <cbc:Description>Example intra-community supply line</cbc:Description>
      <!-- Item name (BT-153) -->
      <cbc:Name>GOODS-001</cbc:Name>
      <cac:ClassifiedTaxCategory>
        <!-- Invoiced item VAT category code (BT-151) -->
        <cbc:ID>AE</cbc:ID>
        <!-- Invoiced item VAT rate (BT-152) -->
        <cbc:Percent>0</cbc:Percent>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:ClassifiedTaxCategory>
    </cac:Item>
    <cac:Price>
      <!-- Item net price (BT-146) -->
      <cbc:PriceAmount currencyID="EUR">1000.00</cbc:PriceAmount>
    </cac:Price>
  </cac:InvoiceLine>

</Invoice>
