<?xml version="1.0" encoding="UTF-8"?>
<Invoice xmlns:cac="urn:pagero:CommonAggregateComponents:1.0" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" xmlns:puf="urn:pagero:ExtensionComponent:1.0" xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2" xmlns="urn:pagero:PageroUniversalFormat:Invoice:1.0">
  <!--
        Values in this file are based on the KSeF FA(3) sample FA_3_Przykład_2.xml.
        KOR correction invoice using Method 3 (StanPrzed / StanPo approach).
        The original line state is carried with stanPrzed=true; the corrected line follows.
        Corresponding invoice type in FA (3): KOR.
        In applicable cases the corresponding FA XML element is mentioned in parenthesis.
    -->
  <ext:UBLExtensions>
    <!-- Place of issue (P_1M) -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>placeOfIssue</puf:Key>
            <puf:Value>Warszawa</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Checkout method (P_16): value 2 = false -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>checkoutMethod</puf:Key>
            <puf:Value>false</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Type of correction (TypKorekty): 3 = correction resulting in a different date -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>correctionType</puf:Key>
            <puf:Value>3</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
  </ext:UBLExtensions>
  <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
  <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
  <!-- BT-1 Correction invoice number (P_2) -->
  <cbc:ID>FK2026/03/200</cbc:ID>
  <!-- BT-2 Correction invoice issue date (P_1) -->
  <cbc:IssueDate>2026-03-15</cbc:IssueDate>
  <!-- BT-3 Invoice type code (RodzajFaktury): KOR - Correction invoice -->
  <cbc:InvoiceTypeCode name="KOR">384</cbc:InvoiceTypeCode>
  <!-- BT-22 Footer note (Stopka/Informacje/StopkaFaktury) -->
  <cbc:Note>Kapiał zakładowy 5 000 000</cbc:Note>
  <!-- BT-5 Invoice document currency (KodWaluty) -->
  <cbc:DocumentCurrencyCode>PLN</cbc:DocumentCurrencyCode>
  <!-- BG-3 Reference to invoice being corrected (DaneFaKorygowanej) -->
  <cac:BillingReference>
    <cac:InvoiceDocumentReference>
      <ext:UBLExtensions>
        <ext:UBLExtension>
          <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:BillingReferenceExtension</ext:ExtensionURI>
          <ext:ExtensionContent>
            <puf:PageroExtension>
              <puf:BillingReferenceExtension>
                <!-- KSeF reference number of corrected invoice (NrKSeFFaKorygowanej) -->
                <puf:ClearanceID>9999999999-20230908-8BEF280C8D35-4D</puf:ClearanceID>
                <!-- Reason for correction (PrzyczynaKorekty) -->
                <cbc:Note>obniżka ceny o 200 zł z uwagi na uszkodzenia estetyczne</cbc:Note>
              </puf:BillingReferenceExtension>
            </puf:PageroExtension>
          </ext:ExtensionContent>
        </ext:UBLExtension>
      </ext:UBLExtensions>
      <!-- BT-25 Corrected invoice number (DaneFaKorygowanej/NrFaKorygowanej) -->
      <cbc:ID>FV2026/02/150</cbc:ID>
      <!-- BT-26 Date of issue of corrected invoice (DaneFaKorygowanej/DataWystFaKorygowanej) -->
      <cbc:IssueDate>2026-02-15</cbc:IssueDate>
    </cac:InvoiceDocumentReference>
  </cac:BillingReference>
  <!-- BG-4 Seller party (Podmiot1) -->
  <cac:AccountingSupplierParty>
    <cac:Party>
      <!-- Additional seller ID (REGON — Stopka/Rejestry/REGON) -->
      <cac:PartyIdentification>
        <cbc:ID schemeID="PL:REGON">999999999</cbc:ID>
      </cac:PartyIdentification>
      <!-- Additional seller ID (KRS — Stopka/Rejestry/KRS) -->
      <cac:PartyIdentification>
        <cbc:ID schemeID="PL:KRS">0000099999</cbc:ID>
      </cac:PartyIdentification>
      <!-- Additional seller ID (BDO — Stopka/Rejestry/BDO) -->
      <cac:PartyIdentification>
        <cbc:ID schemeID="PL:BDO">000099999</cbc:ID>
      </cac:PartyIdentification>
      <cac:PostalAddress>
        <!-- BT-35 Seller street (Adres/AdresL1) -->
        <cbc:StreetName>ul. Kwiatowa 1 m. 2</cbc:StreetName>
        <!-- Building number (NrDomu) -->
        <cbc:BuildingNumber>1</cbc:BuildingNumber>
        <!-- BT-37 Seller city (Adres/AdresL2) -->
        <cbc:CityName>Warszawa</cbc:CityName>
        <!-- BT-38 Seller post code (Adres/AdresL2) -->
        <cbc:PostalZone>00-001</cbc:PostalZone>
        <cac:Country>
          <!-- BT-40 Seller country code (Adres/KodKraju) -->
          <cbc:IdentificationCode>PL</cbc:IdentificationCode>
        </cac:Country>
      </cac:PostalAddress>
      <cac:PartyTaxScheme>
        <!-- BT-31 Seller NIP (Podmiot1/DaneIdentyfikacyjne/NIP) -->
        <cbc:CompanyID>9999999999</cbc:CompanyID>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:PartyTaxScheme>
      <cac:PartyLegalEntity>
        <!-- BT-27 Seller name (Podmiot1/DaneIdentyfikacyjne/Nazwa) -->
        <cbc:RegistrationName>ABC AGD sp. z o. o.</cbc:RegistrationName>
      </cac:PartyLegalEntity>
    </cac:Party>
    <cac:AccountingContact>
      <!-- BT-42 Seller telephone (Podmiot1/DaneKontaktowe/Telefon) -->
      <cbc:Telephone>667444555</cbc:Telephone>
      <!-- BT-43 Seller email (Podmiot1/DaneKontaktowe/Email) -->
      <cbc:ElectronicMail>abc@abc.pl</cbc:ElectronicMail>
    </cac:AccountingContact>
  </cac:AccountingSupplierParty>
  <!-- BG-7 Buyer party (Podmiot2) -->
  <cac:AccountingCustomerParty>
    <!-- Customer number (Podmiot2/NrKlienta) -->
    <cbc:SupplierAssignedAccountID>fdfd778343</cbc:SupplierAssignedAccountID>
    <cac:Party>
      <cac:PostalAddress>
        <!-- BT-50 Buyer street (Adres/AdresL1) -->
        <cbc:StreetName>ul. Polna 1</cbc:StreetName>
        <!-- Building number (NrDomu) -->
        <cbc:BuildingNumber>1</cbc:BuildingNumber>
        <!-- BT-52 Buyer city (Adres/AdresL2) -->
        <cbc:CityName>Warszawa</cbc:CityName>
        <!-- BT-53 Buyer post code (Adres/AdresL2) -->
        <cbc:PostalZone>00-001</cbc:PostalZone>
        <cac:Country>
          <!-- BT-55 Buyer country code (Adres/KodKraju) -->
          <cbc:IdentificationCode>PL</cbc:IdentificationCode>
        </cac:Country>
      </cac:PostalAddress>
      <cac:PartyTaxScheme>
        <!-- BT-48 Buyer NIP (Podmiot2/DaneIdentyfikacyjne/NIP) -->
        <cbc:CompanyID>1111111111</cbc:CompanyID>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:PartyTaxScheme>
      <cac:PartyLegalEntity>
        <!-- BT-44 Buyer name (Podmiot2/DaneIdentyfikacyjne/Nazwa) -->
        <cbc:RegistrationName>F.H.U. Jan Kowalski</cbc:RegistrationName>
      </cac:PartyLegalEntity>
    </cac:Party>
    <cac:AccountingContact>
      <!-- BT-57 Buyer telephone (Podmiot2/DaneKontaktowe/Telefon) -->
      <cbc:Telephone>555777999</cbc:Telephone>
      <!-- BT-58 Buyer email (Podmiot2/DaneKontaktowe/Email) -->
      <cbc:ElectronicMail>jan@kowalski.pl</cbc:ElectronicMail>
    </cac:AccountingContact>
  </cac:AccountingCustomerParty>
  <cac:Delivery>
    <!-- BT-72 Delivery date (P_6) -->
    <cbc:ActualDeliveryDate>2026-01-27</cbc:ActualDeliveryDate>
  </cac:Delivery>
  <!-- BG-23 VAT breakdown — net change amounts (P_13_1 / P_14_1) -->
  <cac:TaxTotal>
    <!-- BT-110 Total VAT change amount -->
    <cbc:TaxAmount currencyID="PLN">-37.40</cbc:TaxAmount>
    <cac:TaxSubtotal>
      <!-- BT-116 Net change at 23% (P_13_1) -->
      <cbc:TaxableAmount currencyID="PLN">-162.60</cbc:TaxableAmount>
      <!-- BT-117 VAT change at 23% (P_14_1) -->
      <cbc:TaxAmount currencyID="PLN">-37.40</cbc:TaxAmount>
      <cac:TaxCategory>
        <!-- BT-118 Tax category code -->
        <cbc:ID>S</cbc:ID>
        <!-- BT-119 Tax category rate (P_12=23) -->
        <cbc:Percent>23.00</cbc:Percent>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:TaxCategory>
    </cac:TaxSubtotal>
  </cac:TaxTotal>
  <!-- BG-22 Document totals — represent net change, not the sum of all StanPrzed/StanPo line amounts -->
  <cac:LegalMonetaryTotal>
    <!-- BT-106 Net change sum -->
    <cbc:LineExtensionAmount currencyID="PLN">-162.60</cbc:LineExtensionAmount>
    <!-- BT-109 Net change without VAT -->
    <cbc:TaxExclusiveAmount currencyID="PLN">-162.60</cbc:TaxExclusiveAmount>
    <!-- BT-112 Net change with VAT -->
    <cbc:TaxInclusiveAmount currencyID="PLN">-200.00</cbc:TaxInclusiveAmount>
    <!-- BT-115 Amount due for payment (P_15) -->
    <cbc:PayableAmount currencyID="PLN">-200.00</cbc:PayableAmount>
  </cac:LegalMonetaryTotal>
  <!-- BG-25 Invoice lines (Fa/FaWiersz) -->
  <!-- Line 1 — before state (StanPrzed=1): original price before correction -->
  <cac:InvoiceLine>
    <ext:UBLExtensions>
      <ext:UBLExtension>
        <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
        <ext:ExtensionContent>
          <puf:PageroExtension>
            <puf:LineExtension>
              <!-- Universal unique line number (UU_ID) -->
              <puf:RestrictedInformation>
                <puf:Key>universalUniqueLineNumber</puf:Key>
                <puf:Value>aaaa111133339990</puf:Value>
              </puf:RestrictedInformation>
              <!-- StanPrzed=1: marks this line as the original state before correction -->
              <puf:RestrictedInformation>
                <puf:Key>originalLine</puf:Key>
                <puf:Value>true</puf:Value>
              </puf:RestrictedInformation>
              <!-- Line subtotal excluding allowances/charges (P_11) -->
              <puf:LineExclAllowanceChargeAmount currencyID="PLN">1626.01</puf:LineExclAllowanceChargeAmount>
            </puf:LineExtension>
          </puf:PageroExtension>
        </ext:ExtensionContent>
      </ext:UBLExtension>
    </ext:UBLExtensions>
    <!-- BT-126 Line number (NrWierszaFa) -->
    <cbc:ID>1</cbc:ID>
    <!-- BT-129 Invoiced quantity (P_8B). Unit code (P_8A: szt. → EA) -->
    <cbc:InvoicedQuantity unitCode="EA">1</cbc:InvoicedQuantity>
    <!-- BT-131 Line net amount — original value (P_11) -->
    <cbc:LineExtensionAmount currencyID="PLN">1626.01</cbc:LineExtensionAmount>
    <!-- Line-level tax (BT-151/BT-152) -->
    <cac:Item>
      <!-- BT-153 Item name (P_7) -->
      <cbc:Name>lodówka Zimnotech mk1</cbc:Name>
      <cac:ClassifiedTaxCategory>
        <cbc:ID>S</cbc:ID>
        <cbc:Percent>23</cbc:Percent>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:ClassifiedTaxCategory>
    </cac:Item>
    <cac:Price>
      <!-- BT-146 Item net price — original price (P_9A) -->
      <cbc:PriceAmount currencyID="PLN">1626.01</cbc:PriceAmount>
    </cac:Price>
  </cac:InvoiceLine>
  <!-- Line 1 — after state (StanPo): corrected price following the 200 PLN reduction -->
  <cac:InvoiceLine>
    <ext:UBLExtensions>
      <ext:UBLExtension>
        <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
        <ext:ExtensionContent>
          <puf:PageroExtension>
            <puf:LineExtension>
              <!-- Universal unique line number — same UU_ID as the StanPrzed line (UU_ID) -->
              <puf:RestrictedInformation>
                <puf:Key>universalUniqueLineNumber</puf:Key>
                <puf:Value>aaaa111133339990</puf:Value>
              </puf:RestrictedInformation>
              <!-- Line subtotal excluding allowances/charges (P_11) -->
              <puf:LineExclAllowanceChargeAmount currencyID="PLN">1463.41</puf:LineExclAllowanceChargeAmount>
            </puf:LineExtension>
          </puf:PageroExtension>
        </ext:ExtensionContent>
      </ext:UBLExtension>
    </ext:UBLExtensions>
    <!-- BT-126 Line number (NrWierszaFa) — same as StanPrzed line -->
    <cbc:ID>1</cbc:ID>
    <!-- BT-129 Invoiced quantity (P_8B) -->
    <cbc:InvoicedQuantity unitCode="EA">1</cbc:InvoicedQuantity>
    <!-- BT-131 Line net amount — corrected value (P_11) -->
    <cbc:LineExtensionAmount currencyID="PLN">1463.41</cbc:LineExtensionAmount>
    <!-- Line-level tax (BT-151/BT-152) -->
    <cac:Item>
      <!-- BT-153 Item name (P_7) -->
      <cbc:Name>lodówka Zimnotech mk1</cbc:Name>
      <cac:ClassifiedTaxCategory>
        <cbc:ID>S</cbc:ID>
        <cbc:Percent>23</cbc:Percent>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:ClassifiedTaxCategory>
    </cac:Item>
    <cac:Price>
      <!-- BT-146 Item net price — corrected price (P_9A) -->
      <cbc:PriceAmount currencyID="PLN">1463.41</cbc:PriceAmount>
    </cac:Price>
  </cac:InvoiceLine>
</Invoice>
