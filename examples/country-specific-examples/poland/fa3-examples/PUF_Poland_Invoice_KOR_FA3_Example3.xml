    <cbc:PayableAmount currencyID="PLN">-200.00</cbc:PayableAmount>
  </cac:LegalMonetaryTotal>
  <!-- BG-25 Invoice lines — single line showing the net change (Method 2) -->
  <cac:InvoiceLine>
    <ext:UBLExtensions>
      <ext:UBLExtension>
        <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
        <ext:ExtensionContent>
          <puf:PageroExtension>
            <puf:LineExtension>
              <!-- Universal unique line number (UU_ID) — same as original invoice line -->
              <puf:RestrictedInformation>
                <puf:Key>universalUniqueLineNumber</puf:Key>
                <puf:Value>aaaa111133339990</puf:Value>
              </puf:RestrictedInformation>
              <!-- Line subtotal (P_11) -->
              <puf:LineExclAllowanceChargeAmount currencyID="PLN">-162.60</puf:LineExclAllowanceChargeAmount>
            </puf:LineExtension>
          </puf:PageroExtension>
        </ext:ExtensionContent>
      </ext:UBLExtension>
    </ext:UBLExtensions>
    <!-- BT-126 Line number (NrWierszaFa) -->
    <cbc:ID>1</cbc:ID>
    <!-- BT-129 Invoiced quantity (P_8B) -->
