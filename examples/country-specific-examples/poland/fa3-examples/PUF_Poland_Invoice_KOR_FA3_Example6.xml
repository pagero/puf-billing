  <!--
        Values in this file are based on the KSeF FA(3) sample FA_3_Przykład_6.xml.
        KOR collective correction invoice covering six invoices from H1 2026 (pierwsze półrocze).
        Six BillingReferences (DaneFaKorygowanej) reference each corrected invoice by
        its number and date. KSeF references are carried at document level as multiple
        KSEFReferenceNumber blocks (one per corrected invoice). OkresFaKorygowanej is
        mapped as RestrictedInformation key "correctedInvoicesPeriod". No FaWiersz in
        FA(3) source; a single summary InvoiceLine carries the correction amount.
        Corresponding invoice type in FA (3): KOR.
        TypKorekty=2: correction effective on the correction invoice date.
        In applicable cases the corresponding FA XML element is mentioned in parenthesis.
    -->
  <ext:UBLExtensions>
    <!-- Place of issue (P_1M) -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>placeOfIssue</puf:Key>
            <puf:Value>Warszawa</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Checkout method (P_16): value 2 = false -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>checkoutMethod</puf:Key>
            <puf:Value>false</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Type of correction (TypKorekty): 2 = correction effective on correction invoice date -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>correctionType</puf:Key>
            <puf:Value>2</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Period of corrected invoices (OkresFaKorygowanej) -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>correctedInvoicesPeriod</puf:Key>
            <puf:Value>pierwsze półrocze 2026</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
  </ext:UBLExtensions>
  <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
  <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
  <!-- BT-1 Correction invoice number (P_2) -->
  <cbc:ID>FK2026/07/243</cbc:ID>
  <!-- BT-2 Correction invoice issue date (P_1) -->
  <cbc:IssueDate>2026-07-15</cbc:IssueDate>
  <!-- BT-3 Invoice type code (RodzajFaktury): KOR - Correction invoice -->
  <cbc:InvoiceTypeCode name="KOR">384</cbc:InvoiceTypeCode>
  <!-- BT-22 Footer note (Stopka/Informacje/StopkaFaktury) -->
  <cbc:Note>Kapiał zakładowy 5 000 000</cbc:Note>
  <!-- BT-5 Invoice document currency (KodWaluty) -->
  <cbc:DocumentCurrencyCode>PLN</cbc:DocumentCurrencyCode>
  <!-- BG-3 References to all six invoices being corrected (DaneFaKorygowanej × 6) -->
  <!-- BillingReference 1: FV2026/01/134 — carries the reason for correction -->
  <cac:BillingReference>
