  <!-- BG-22 Document totals -->
  <cac:LegalMonetaryTotal>
    <cbc:LineExtensionAmount currencyID="PLN">-40650.41</cbc:LineExtensionAmount>
    <cbc:TaxExclusiveAmount currencyID="PLN">-40650.41</cbc:TaxExclusiveAmount>
    <cbc:TaxInclusiveAmount currencyID="PLN">-50000.00</cbc:TaxInclusiveAmount>
