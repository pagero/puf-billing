          <ext:ExtensionContent>
            <puf:PageroExtension>
              <puf:BillingReferenceExtension>
                <!-- KSeF reference number of corrected invoice (NrKSeFFaKorygowanej) -->
                <puf:ClearanceID>9999999999-20230908-8BEF280C8D35-4D</puf:ClearanceID>
                <!-- Reason for correction (PrzyczynaKorekty) — applies to all six invoices -->
                <cbc:Note>rabat 50000 z uwagi na poziom zakupów pierwszym półroczu 2026</cbc:Note>
              </puf:BillingReferenceExtension>
            </puf:PageroExtension>
