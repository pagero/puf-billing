  <!-- BG-25 InvoiceLine is required by the PUF schema but the KSeF FA(3) sample has no FaWiersz
       for this collective rebate correction. The transform will output a FaWiersz from this line,
       which is an unavoidable mismatch: PUF requires at least one line; FA(3) requires none here. -->
  <cac:InvoiceLine>
    <ext:UBLExtensions>
      <ext:UBLExtension>
        <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
        <ext:ExtensionContent>
          <puf:PageroExtension>
            <puf:LineExtension>
