  <!-- BG-23 VAT breakdown — net change amounts (P_13_1 / P_14_1) -->
  <cac:TaxTotal>
    <!-- BT-110 Total VAT change -->
    <cbc:TaxAmount currencyID="PLN">-9349.59</cbc:TaxAmount>
    <cac:TaxSubtotal>
      <!-- BT-116 Net change at 23% (P_13_1) -->
      <cbc:TaxableAmount currencyID="PLN">-40650.41</cbc:TaxableAmount>
      <!-- BT-117 VAT change at 23% (P_14_1) -->
      <cbc:TaxAmount currencyID="PLN">-9349.59</cbc:TaxAmount>
      <cac:TaxCategory>
        <cbc:ID>S</cbc:ID>
        <cbc:Percent>23.00</cbc:Percent>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
