        carried at header level. In PUF the line carries the full net change amount.
    -->
  <cac:InvoiceLine>
    <ext:UBLExtensions>
      <ext:UBLExtension>
        <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
        <ext:ExtensionContent>
