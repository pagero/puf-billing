  <!--
        Values in this file are based on the KSeF FA(3) sample FA_3_Przykład_7.xml.
        KOR collective correction covering H1 2026 — identical to Example 6 but with one
        FaWiersz that identifies the corrected product (lodówka Zimnotech mk1, CN 8418 21 91,
        quantity 1000) without specifying line amounts. In PUF the informational line carries
        the full correction amount; LineExtensionAmount = net change (P_13_1 = -40650.41).
        Corresponding invoice type in FA (3): KOR.
        TypKorekty=2: correction effective on the correction invoice date.
        In applicable cases the corresponding FA XML element is mentioned in parenthesis.
    -->
  <ext:UBLExtensions>
    <!-- Place of issue (P_1M) -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>placeOfIssue</puf:Key>
            <puf:Value>Warszawa</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Checkout method (P_16): value 2 = false -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>checkoutMethod</puf:Key>
            <puf:Value>false</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Type of correction (TypKorekty): 2 = correction effective on correction invoice date -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>correctionType</puf:Key>
            <puf:Value>2</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Period of corrected invoices (OkresFaKorygowanej) -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>correctedInvoicesPeriod</puf:Key>
            <puf:Value>pierwsze półrocze 2026</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
  </ext:UBLExtensions>
