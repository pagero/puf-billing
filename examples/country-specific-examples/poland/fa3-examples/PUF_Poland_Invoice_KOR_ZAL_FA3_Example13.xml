    <!--
        Values in this file are based on the KSeF FA(3) sample FA_3_Przykład_13.xml.
        KOR_ZAL correction of advance invoice FZ2026/02/150.
        Reason: korekta wartości zamówienia o -10% (order value reduction of 10%).
        TypKorekty=3. PayableAmount=0 (P_15=0). No header P_13/P_14 in source FA_3.
        WartoscZamowienia updated to 337635 after correction.
        P_15ZK=30000 (amount on corrected advance).
        Two pairs of before/after ZamowienieWiersz rows:
          - Line 1: apartment price reduces (341666.67 → 307500 @ 8%)
          - Line 2: services price reduces (5000 → 4500 @ 23%)
        Podmiot3 Rola=4 (F.H.U. Grażyna Kowalska, 50% share).
        Corresponding invoice type in FA (3): KOR_ZAL.
        In applicable cases the corresponding FA XML element is mentioned in parenthesis.
    -->
    <ext:UBLExtensions>
        <!-- Place of issue (P_1M) -->
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:RestrictedInformation>
                        <puf:Key>placeOfIssue</puf:Key>
                        <puf:Value>Warszawa</puf:Value>
                    </puf:RestrictedInformation>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
        <!-- Checkout method (P_16): value 2 = false -->
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:RestrictedInformation>
                        <puf:Key>checkoutMethod</puf:Key>
                        <puf:Value>false</puf:Value>
                    </puf:RestrictedInformation>
