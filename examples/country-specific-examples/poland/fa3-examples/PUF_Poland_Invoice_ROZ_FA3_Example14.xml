    </cac:TaxSubtotal>
  </cac:TaxTotal>
  <!-- BG-22 Document totals -->
  <cac:LegalMonetaryTotal>
    <!-- BT-106 Sum of line net amounts: P_13_1 + P_13_2 = 4100.16 + 280177.59 -->
    <cbc:LineExtensionAmount currencyID="PLN">284277.75</cbc:LineExtensionAmount>
    <cbc:TaxExclusiveAmount currencyID="PLN">284277.75</cbc:TaxExclusiveAmount>
    <!-- BT-112 Total with VAT (P_15=307635) -->
    <cbc:TaxInclusiveAmount currencyID="PLN">307635.00</cbc:TaxInclusiveAmount>
    <!-- BT-115 Amount due for payment (P_15=307635) -->
    <cbc:PayableAmount currencyID="PLN">307635.00</cbc:PayableAmount>
  </cac:LegalMonetaryTotal>
