<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<Invoice xmlns:cac="urn:pagero:CommonAggregateComponents:1.0"
    xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
    xmlns:puf="urn:pagero:ExtensionComponent:1.0"
    xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
    xmlns="urn:pagero:PageroUniversalFormat:Invoice:1.0">
    <!--
        Values in this file are based on the KSeF FA(3) sample Fa_3_Przykład_17.xml.
        ROZ settlement invoice — INTENTIONALLY INCORRECT (300,000 instead of 307,635).
        This error is the basis for the correction in Example 18 (KOR_ROZ).
        Seller: ABC Developex S.A. (legal form change from sp. z o. o.).
        Only ONE Podmiot3 (Rola=4, F.H.U. Grażyna Kowalska, 50%); no Rola=3.
        PrepaidPayment with KSeF advance invoice reference.
        Line 1: mieszkanie 50m^2, 8% VAT, GTU_10.
        Line 2: usługi dodatkowe, 23% VAT.
        No payment due date (Platnosc missing in FA_3 source).
        Corresponding invoice type in FA (3): ROZ.
        In applicable cases the corresponding FA XML element is mentioned in parenthesis.
    -->
    <ext:UBLExtensions>
        <!-- Place of issue (P_1M) -->
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:RestrictedInformation>
                        <puf:Key>placeOfIssue</puf:Key>
                        <puf:Value>Warszawa</puf:Value>
                    </puf:RestrictedInformation>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
        <!-- Checkout method (P_16): value 2 = false -->
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:RestrictedInformation>
                        <puf:Key>checkoutMethod</puf:Key>
                        <puf:Value>false</puf:Value>
                    </puf:RestrictedInformation>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
        <!-- Advance invoice KSeF reference (FakturaZaliczkowa/NrKSeFFaZaliczkowej) -->
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:RestrictedInformation>
                        <puf:Key>NrKSeFFaZaliczkowej</puf:Key>
                        <puf:Value>9999999999-20230908-8BEF280C8D35-4D</puf:Value>
                    </puf:RestrictedInformation>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
        <!-- Additional purchaser (Podmiot3 Rola=4): F.H.U. Grażyna Kowalska, 50% share -->
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformationParty</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:RestrictedInformationParty>
                        <puf:Key>additionalBuyer</puf:Key>
                        <cac:Party>
                            <cac:PostalAddress>
                                <cbc:StreetName>ul. Polna 1</cbc:StreetName>
                                <cbc:BuildingNumber>1</cbc:BuildingNumber>
                                <cbc:CityName>Warszawa</cbc:CityName>
                                <cbc:PostalZone>00-001</cbc:PostalZone>
                                <cac:Country>
                                    <cbc:IdentificationCode>PL</cbc:IdentificationCode>
                                </cac:Country>
                            </cac:PostalAddress>
                            <cac:PartyTaxScheme>
                                <cbc:CompanyID>3333333333</cbc:CompanyID>
                                <cac:TaxScheme>
                                    <cbc:ID>VAT</cbc:ID>
                                </cac:TaxScheme>
                            </cac:PartyTaxScheme>
                            <cac:PartyLegalEntity>
                                <cbc:RegistrationName>F.H.U. Grażyna Kowalska</cbc:RegistrationName>
                            </cac:PartyLegalEntity>
                            <cac:Contact>
                                <cbc:Telephone>555777999</cbc:Telephone>
                                <cbc:ElectronicMail>jan@kowalski.pl</cbc:ElectronicMail>
                            </cac:Contact>
                        </cac:Party>
                        <!-- Share percentage (Udzial=50) -->
                        <cbc:Description>50</cbc:Description>
                    </puf:RestrictedInformationParty>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
    </ext:UBLExtensions>
    <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
    <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
    <!-- BT-1 Invoice number (P_2) -->
    <cbc:ID>FV2026/08/12</cbc:ID>
    <!-- BT-2 Invoice issue date (P_1) -->
    <cbc:IssueDate>2026-08-17</cbc:IssueDate>
    <!-- BT-3 Invoice type code: ROZ - Settlement invoice -->
    <cbc:InvoiceTypeCode name="ROZ">380</cbc:InvoiceTypeCode>
    <!-- BT-22 Footer note -->
    <cbc:Note>Kapiał zakładowy 5 000 000</cbc:Note>
    <!-- BT-22 Additional description (DodatkowyOpis) -->
    <cbc:Note>wysokosć pozostałej do zapłaty kwoty: 300000 zł</cbc:Note>
    <!-- BT-5 Invoice document currency -->
    <cbc:DocumentCurrencyCode>PLN</cbc:DocumentCurrencyCode>
    <!-- BG-4 Seller party (Podmiot1): ABC Developex S.A. -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <cac:PartyIdentification>
                <cbc:ID schemeID="PL:REGON">999999999</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyIdentification>
                <cbc:ID schemeID="PL:KRS">0000099999</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyIdentification>
                <cbc:ID schemeID="PL:BDO">000099999</cbc:ID>
            </cac:PartyIdentification>
            <cac:PostalAddress>
                <cbc:StreetName>ul. Sadowa 1 lok. 3</cbc:StreetName>
                <cbc:BuildingNumber>1</cbc:BuildingNumber>
                <cbc:CityName>Kraków</cbc:CityName>
                <cbc:PostalZone>00-002</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>PL</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>9999999999</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <!-- Seller name: ABC Developex S.A. (changed legal form) -->
                <cbc:RegistrationName>ABC Developex S.A.</cbc:RegistrationName>
            </cac:PartyLegalEntity>
        </cac:Party>
        <cac:AccountingContact>
            <cbc:Telephone>667444555</cbc:Telephone>
            <cbc:ElectronicMail>abc@abc.pl</cbc:ElectronicMail>
        </cac:AccountingContact>
    </cac:AccountingSupplierParty>
    <!-- BG-7 Buyer party (Podmiot2): F.H.U. Jan Kowalski -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <cac:PostalAddress>
                <cbc:StreetName>ul. Polna 1</cbc:StreetName>
                <cbc:BuildingNumber>1</cbc:BuildingNumber>
                <cbc:CityName>Warszawa</cbc:CityName>
                <cbc:PostalZone>00-001</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>PL</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>1111111111</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>F.H.U. Jan Kowalski</cbc:RegistrationName>
            </cac:PartyLegalEntity>
        </cac:Party>
        <cac:AccountingContact>
            <cbc:Telephone>555777999</cbc:Telephone>
            <cbc:ElectronicMail>jan@kowalski.pl</cbc:ElectronicMail>
        </cac:AccountingContact>
    </cac:AccountingCustomerParty>
    <cac:Delivery>
        <!-- BT-72 Delivery date (P_6) -->
        <cbc:ActualDeliveryDate>2026-09-17</cbc:ActualDeliveryDate>
    </cac:Delivery>
    <cac:PaymentMeans>
        <cbc:PaymentMeansCode>48</cbc:PaymentMeansCode>
    </cac:PaymentMeans>
    <!-- Advance invoice reference: FakturaZaliczkowa with KSeF ID (NrKSeFFaZaliczkowej) -->
    <cac:PrepaidPayment>
        <ext:UBLExtensions>
            <ext:UBLExtension>
                <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:PrepaidPaymentExtension</ext:ExtensionURI>
                <ext:ExtensionContent>
                    <puf:PageroExtension>
                        <puf:PrepaidPaymentExtension>
                            <cac:DocumentReference>
                                <ext:UBLExtensions>
                                    <ext:UBLExtension>
                                        <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:BillingReferenceExtension</ext:ExtensionURI>
                                        <ext:ExtensionContent>
                                            <puf:PageroExtension>
                                                <puf:BillingReferenceExtension>
                                                    <!-- KSeF reference of advance invoice (NrKSeFFaZaliczkowej) -->
                                                    <puf:ClearanceID>9999999999-20230908-8BEF280C8D35-4D</puf:ClearanceID>
                                                </puf:BillingReferenceExtension>
                                            </puf:PageroExtension>
                                        </ext:ExtensionContent>
                                    </ext:UBLExtension>
                                </ext:UBLExtensions>
                                <cbc:ID>9999999999-20230908-8BEF280C8D35-4D</cbc:ID>
                            </cac:DocumentReference>
                        </puf:PrepaidPaymentExtension>
                    </puf:PageroExtension>
                </ext:ExtensionContent>
            </ext:UBLExtension>
        </ext:UBLExtensions>
    </cac:PrepaidPayment>
    <!-- BG-23 VAT breakdown -->
    <cac:TaxTotal>
        <!-- BT-110 Total VAT: P_14_1 + P_14_2 = 919.63 + 21857.92 = 22777.55 -->
        <cbc:TaxAmount currencyID="PLN">22777.55</cbc:TaxAmount>
        <!-- 23% breakdown (P_13_1=3998.40 / P_14_1=919.63) -->
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="PLN">3998.40</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="PLN">919.63</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>23.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
        <!-- 8% breakdown (P_13_2=273224.05 / P_14_2=21857.92) -->
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="PLN">273224.05</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="PLN">21857.92</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>8.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>
    <!-- BG-22 Document totals -->
    <cac:LegalMonetaryTotal>
        <!-- BT-106 Sum: P_13_1 + P_13_2 = 3998.40 + 273224.05 = 277222.45 -->
        <cbc:LineExtensionAmount currencyID="PLN">277222.45</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="PLN">277222.45</cbc:TaxExclusiveAmount>
        <!-- BT-112 Total with VAT (P_15=300000) — INTENTIONALLY INCORRECT (should be 307635) -->
        <cbc:TaxInclusiveAmount currencyID="PLN">300000.00</cbc:TaxInclusiveAmount>
        <!-- BT-115 Amount due for payment (P_15=300000) — INTENTIONALLY INCORRECT -->
        <cbc:PayableAmount currencyID="PLN">300000.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>
    <!-- BG-25 Invoice lines -->
    <!-- Line 1 (NrWierszaFa=1): mieszkanie 50m^2, 8% VAT, GTU_10 -->
    <cac:InvoiceLine>
        <ext:UBLExtensions>
            <ext:UBLExtension>
                <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
                <ext:ExtensionContent>
                    <puf:PageroExtension>
                        <puf:LineExtension>
                            <puf:RestrictedInformation>
                                <puf:Key>universalUniqueLineNumber</puf:Key>
                                <puf:Value>aaaa111133339997</puf:Value>
                            </puf:RestrictedInformation>
                            <!-- GTU code (GTU=GTU_10) -->
                            <puf:RestrictedInformation>
                                <puf:Key>GTU</puf:Key>
                                <puf:Value>GTU_10</puf:Value>
                            </puf:RestrictedInformation>
                            <puf:LineExclAllowanceChargeAmount currencyID="PLN">307500.00</puf:LineExclAllowanceChargeAmount>
                        </puf:LineExtension>
                    </puf:PageroExtension>
                </ext:ExtensionContent>
            </ext:UBLExtension>
        </ext:UBLExtensions>
        <cbc:ID>1</cbc:ID>
        <cbc:InvoicedQuantity unitCode="EA">1</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="PLN">307500.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Name>mieszkanie 50m^2</cbc:Name>
            <!-- P_12: VAT rate -->
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>8</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="PLN">307500.00</cbc:PriceAmount>
        </cac:Price>
    </cac:InvoiceLine>
    <!-- Line 2 (NrWierszaFa=2): usługi dodatkowe, 23% VAT -->
    <cac:InvoiceLine>
        <ext:UBLExtensions>
            <ext:UBLExtension>
                <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
                <ext:ExtensionContent>
                    <puf:PageroExtension>
                        <puf:LineExtension>
                            <puf:RestrictedInformation>
                                <puf:Key>universalUniqueLineNumber</puf:Key>
                                <puf:Value>aaaa111133339998</puf:Value>
                            </puf:RestrictedInformation>
                            <puf:LineExclAllowanceChargeAmount currencyID="PLN">4500.00</puf:LineExclAllowanceChargeAmount>
                        </puf:LineExtension>
                    </puf:PageroExtension>
                </ext:ExtensionContent>
            </ext:UBLExtension>
        </ext:UBLExtensions>
        <cbc:ID>2</cbc:ID>
        <cbc:InvoicedQuantity unitCode="EA">1</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="PLN">4500.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Name>usługi dodatkowe</cbc:Name>
            <!-- P_12: VAT rate -->
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>23</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="PLN">4500.00</cbc:PriceAmount>
        </cac:Price>
    </cac:InvoiceLine>
</Invoice>
