<?xml version="1.0" encoding="UTF-8"?>
<Invoice xmlns:cac="urn:pagero:CommonAggregateComponents:1.0" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" xmlns:puf="urn:pagero:ExtensionComponent:1.0" xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2" xmlns="urn:pagero:PageroUniversalFormat:Invoice:1.0">
  <!--
        Values in this file are based on the KSeF FA(3) sample FA_3_Przykład_22.xml.
        VAT invoice in EUR for intra-community supply (WDT).
        Tax category K (WDT), Name="0-WDT", Percent=0, TaxAmount=0.
        Buyer: EU VAT number KodUE=DE + NrVatUE=999999999 → CompanyID=DE999999999.
        P_13_6_2=4000 (WDT base at 0%), P_15=4000.
        Seller: ABC AGD sp. z o. o.
        Buyer: EFG GmbH (Germany).
        Corresponding invoice type in FA (3): VAT.
        In applicable cases the corresponding FA XML element is mentioned in parenthesis.
    -->
  <ext:UBLExtensions>
    <!-- Place of issue (P_1M) -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>placeOfIssue</puf:Key>
            <puf:Value>Warszawa</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Checkout method (P_16): value 2 = false -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>checkoutMethod</puf:Key>
            <puf:Value>false</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
  </ext:UBLExtensions>
  <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
  <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
  <!-- BT-1 Invoice number (P_2) -->
  <cbc:ID>FV2026/02/150</cbc:ID>
  <!-- BT-2 Invoice issue date (P_1) -->
  <cbc:IssueDate>2026-02-15</cbc:IssueDate>
  <!-- BT-3 Invoice type code: VAT -->
  <cbc:InvoiceTypeCode name="VAT">380</cbc:InvoiceTypeCode>
  <!-- BT-22 Footer note -->
  <cbc:Note>Kapiał zakładowy 5 000 000</cbc:Note>
  <!-- BT-5 Invoice document currency (KodWaluty=EUR) -->
  <cbc:DocumentCurrencyCode>EUR</cbc:DocumentCurrencyCode>
  <!-- BG-4 Seller party (Podmiot1): ABC AGD sp. z o. o. -->
  <cac:AccountingSupplierParty>
    <cac:Party>
      <!-- REGON/KRS/BDO from Stopka -->
      <cac:PartyIdentification>
        <cbc:ID schemeID="PL:REGON">999999999</cbc:ID>
      </cac:PartyIdentification>
      <cac:PartyIdentification>
        <cbc:ID schemeID="PL:KRS">0000099999</cbc:ID>
      </cac:PartyIdentification>
      <cac:PartyIdentification>
        <cbc:ID schemeID="PL:BDO">000099999</cbc:ID>
      </cac:PartyIdentification>
      <cac:PostalAddress>
        <cbc:StreetName>ul. Kwiatowa 1 m. 2</cbc:StreetName>
        <cbc:BuildingNumber>1</cbc:BuildingNumber>
        <cbc:CityName>Warszawa</cbc:CityName>
        <cbc:PostalZone>00-001</cbc:PostalZone>
        <cac:Country>
          <cbc:IdentificationCode>PL</cbc:IdentificationCode>
        </cac:Country>
      </cac:PostalAddress>
      <cac:PartyTaxScheme>
        <cbc:CompanyID>9999999999</cbc:CompanyID>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:PartyTaxScheme>
      <cac:PartyLegalEntity>
        <cbc:RegistrationName>ABC AGD sp. z o. o.</cbc:RegistrationName>
      </cac:PartyLegalEntity>
    </cac:Party>
    <cac:AccountingContact>
      <cbc:Telephone>667444555</cbc:Telephone>
      <cbc:ElectronicMail>abc@abc.pl</cbc:ElectronicMail>
    </cac:AccountingContact>
  </cac:AccountingSupplierParty>
  <!-- BG-7 Buyer party (Podmiot2): EFG GmbH (Germany), EU VAT number DE999999999 -->
  <cac:AccountingCustomerParty>
    <cac:Party>
      <cac:PostalAddress>
        <cbc:StreetName>Blümchenstraße 1</cbc:StreetName>
        <cbc:BuildingNumber>1</cbc:BuildingNumber>
        <cbc:CityName>Berlin</cbc:CityName>
        <cbc:PostalZone>10999</cbc:PostalZone>
        <cac:Country>
          <!-- KodKraju=DE -->
          <cbc:IdentificationCode>DE</cbc:IdentificationCode>
        </cac:Country>
      </cac:PostalAddress>
      <cac:PartyTaxScheme>
        <!-- EU VAT number: KodUE=DE + NrVatUE=999999999 → DE999999999 -->
        <cbc:CompanyID>DE999999999</cbc:CompanyID>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:PartyTaxScheme>
      <cac:PartyLegalEntity>
        <!-- BT-44 Buyer name (Nazwa=EFG GmbH) -->
        <cbc:RegistrationName>EFG GmbH</cbc:RegistrationName>
      </cac:PartyLegalEntity>
    </cac:Party>
    <cac:AccountingContact>
      <cbc:Telephone>555777999</cbc:Telephone>
      <cbc:ElectronicMail>johan@shmidt.de</cbc:ElectronicMail>
    </cac:AccountingContact>
  </cac:AccountingCustomerParty>
  <cac:PaymentMeans>
    <cbc:PaymentMeansCode>48</cbc:PaymentMeansCode>
  </cac:PaymentMeans>
  <!--
        BG-23 VAT breakdown: WDT (P_13_6_2=4000, TaxAmount=0).
        Category K = intra-community supply at zero rate.
        Name="0-WDT" indicates the Polish WDT zero-rate type.
    -->
  <cac:TaxTotal>
    <!-- BT-110 Total VAT = 0 (WDT zero rate) -->
    <cbc:TaxAmount currencyID="EUR">0.00</cbc:TaxAmount>
    <!-- WDT subtotal (P_13_6_2=4000) -->
    <cac:TaxSubtotal>
      <cbc:TaxableAmount currencyID="EUR">4000.00</cbc:TaxableAmount>
      <cbc:TaxAmount currencyID="EUR">0.00</cbc:TaxAmount>
      <cac:TaxCategory>
        <!-- K = intra-community supply (WDT) -->
        <cbc:ID>K</cbc:ID>
        <!-- 0-WDT: Polish tax code for intra-community supply -->
        <cbc:Name>0-WDT</cbc:Name>
        <cbc:Percent>0.00</cbc:Percent>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:TaxCategory>
    </cac:TaxSubtotal>
  </cac:TaxTotal>
  <!-- BG-22 Document totals -->
  <cac:LegalMonetaryTotal>
    <cbc:LineExtensionAmount currencyID="EUR">4000.00</cbc:LineExtensionAmount>
    <cbc:TaxExclusiveAmount currencyID="EUR">4000.00</cbc:TaxExclusiveAmount>
    <!-- BT-112 Total with VAT (P_15=4000) -->
    <cbc:TaxInclusiveAmount currencyID="EUR">4000.00</cbc:TaxInclusiveAmount>
    <!-- BT-115 Amount due for payment (P_15=4000) -->
    <cbc:PayableAmount currencyID="EUR">4000.00</cbc:PayableAmount>
  </cac:LegalMonetaryTotal>
  <!-- BG-25 Invoice lines -->
  <!-- Line 1 (NrWierszaFa=1): lodówka Zimnotech mk1, 10 szt., EUR 400, P_6A=2026-01-03, P_12=0 WDT -->
  <cac:InvoiceLine>
    <ext:UBLExtensions>
      <ext:UBLExtension>
        <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
        <ext:ExtensionContent>
          <puf:PageroExtension>
            <puf:LineExtension>
              <puf:RestrictedInformation>
                <puf:Key>universalUniqueLineNumber</puf:Key>
                <puf:Value>aaaa111133339990</puf:Value>
              </puf:RestrictedInformation>
              <puf:LineExclAllowanceChargeAmount currencyID="EUR">4000.00</puf:LineExclAllowanceChargeAmount>
            </puf:LineExtension>
          </puf:PageroExtension>
        </ext:ExtensionContent>
      </ext:UBLExtension>
    </ext:UBLExtensions>
    <cbc:ID>1</cbc:ID>
    <cbc:InvoicedQuantity unitCode="EA">10</cbc:InvoicedQuantity>
    <cbc:LineExtensionAmount currencyID="EUR">4000.00</cbc:LineExtensionAmount>
    <!-- Per-line delivery date (P_6A=2026-01-03) -->
    <cac:Delivery>
      <cbc:ActualDeliveryDate>2026-01-03</cbc:ActualDeliveryDate>
    </cac:Delivery>
    <!-- Line-level tax: WDT, K, 0%, TaxAmount=0 -->
    <cac:Item>
      <cbc:Name>lodówka Zimnotech mk1</cbc:Name>
      <cac:ClassifiedTaxCategory>
        <cbc:ID>K</cbc:ID>
        <cbc:Name>0-WDT</cbc:Name>
        <cbc:Percent>0</cbc:Percent>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:ClassifiedTaxCategory>
    </cac:Item>
    <cac:Price>
      <cbc:PriceAmount currencyID="EUR">400.00</cbc:PriceAmount>
    </cac:Price>
  </cac:InvoiceLine>
</Invoice>
