<?xml version="1.0" encoding="UTF-8"?>
<Invoice xmlns:cac="urn:pagero:CommonAggregateComponents:1.0" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" xmlns:puf="urn:pagero:ExtensionComponent:1.0" xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2" xmlns="urn:pagero:PageroUniversalFormat:Invoice:1.0">
  <!--
        Values in this file are based on the KSeF FA(3) sample FA_3_Przykład_4.xml.
        VAT invoice with factoring party (Podmiot3 Rola=1), WZ delivery note reference,
        three lines with per-line delivery dates (P_6A) and CN commodity codes,
        a per-unit price discount on line 2 (P_10), and a credit deduction (Rozliczenie).
        Payment routed to the factoring company's bank account (RachunekBankowyFaktora).
        Corresponding invoice type in FA (3): VAT.
        In applicable cases the corresponding FA XML element is mentioned in parenthesis.
        Added: Transport block (WysylkaDo, Przewoznik, WysylkaZ, RodzajTransportu),
        DeliveryTerms (WarunkiDostawy=CIP), CurrencyCode (OpisRachunku=PLN),
        AllowanceCharge with reason (Odliczenia/Powod).
    -->
  <ext:UBLExtensions>
    <!-- Place of issue (P_1M) -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>placeOfIssue</puf:Key>
            <puf:Value>Warszawa</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Checkout method (P_16): value 2 = false -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>checkoutMethod</puf:Key>
            <puf:Value>false</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Delivery note reference (WZ) -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>wz</puf:Key>
            <puf:Value>44343434/2026</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Lot number (WarunkiTransakcji/NrPartiiTowaru) -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>NrPartiiTowaru</puf:Key>
            <puf:Value>2312323/2026</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Factoring party (Podmiot3, Rola=1): payment is routed to the factoring company -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformationParty</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformationParty>
            <puf:Key>factor</puf:Key>
            <cac:Party>
              <cac:PostalAddress>
                <cbc:StreetName>ul. Bankowa 1</cbc:StreetName>
                <cbc:CityName>Łódź</cbc:CityName>
                <cbc:PostalZone>00-003</cbc:PostalZone>
                <cac:Country>
                  <cbc:IdentificationCode>PL</cbc:IdentificationCode>
                </cac:Country>
              </cac:PostalAddress>
              <cac:PartyTaxScheme>
                <cbc:CompanyID>2222222222</cbc:CompanyID>
                <cac:TaxScheme>
                  <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
              </cac:PartyTaxScheme>
              <cac:PartyLegalEntity>
                <cbc:RegistrationName>Bank Bankowości Bankowej S. A. BBB Faktoring</cbc:RegistrationName>
              </cac:PartyLegalEntity>
              <cac:Contact>
                <cbc:Telephone>666888999</cbc:Telephone>
                <cbc:ElectronicMail>bbb@efaktoring.pl</cbc:ElectronicMail>
              </cac:Contact>
            </cac:Party>
          </puf:RestrictedInformationParty>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Rozliczenie/SumaOdliczen: total deductions = 1000 -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>SumaOdliczen</puf:Key>
            <puf:Value>1000</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
    <!-- Rozliczenie/DoZaplaty: net amount due after deductions = 64279.92 - 1000 = 63279.92 -->
    <ext:UBLExtension>
      <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
      <ext:ExtensionContent>
        <puf:PageroExtension>
          <puf:RestrictedInformation>
            <puf:Key>DoZaplaty</puf:Key>
            <puf:Value>63279.92</puf:Value>
          </puf:RestrictedInformation>
        </puf:PageroExtension>
      </ext:ExtensionContent>
    </ext:UBLExtension>
  </ext:UBLExtensions>
  <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
  <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
  <!-- BT-1 Invoice number (P_2) -->
  <cbc:ID>FV2026/02/150</cbc:ID>
  <!-- BT-2 Invoice issue date (P_1) -->
  <cbc:IssueDate>2026-02-15</cbc:IssueDate>
  <!-- Due date (Platnosc/TerminPlatnosci/Termin) -->
  <cbc:DueDate>2026-03-15</cbc:DueDate>
  <!-- BT-3 Invoice type code (RodzajFaktury): VAT - Standard invoice -->
  <cbc:InvoiceTypeCode name="VAT">380</cbc:InvoiceTypeCode>
  <!-- BT-22 Footer note (Stopka/Informacje/StopkaFaktury) -->
  <cbc:Note>Kapiał zakładowy 5 000 000</cbc:Note>
  <!-- BT-5 Invoice document currency (KodWaluty) -->
  <cbc:DocumentCurrencyCode>PLN</cbc:DocumentCurrencyCode>
  <!-- Order reference (WarunkiTransakcji/Zamowienia) -->
  <cac:OrderReference>
    <!-- Order number (NrZamowienia) -->
    <cbc:ID>4354343</cbc:ID>
    <!-- Order date (DataZamowienia) -->
    <cbc:IssueDate>2026-01-26</cbc:IssueDate>
  </cac:OrderReference>
  <!-- BG-4 Seller party (Podmiot1) -->
  <cac:AccountingSupplierParty>
    <cac:Party>
      <cac:PartyIdentification>
        <cbc:ID schemeID="PL:REGON">999999999</cbc:ID>
      </cac:PartyIdentification>
      <cac:PartyIdentification>
        <cbc:ID schemeID="PL:KRS">0000099999</cbc:ID>
      </cac:PartyIdentification>
      <cac:PartyIdentification>
        <cbc:ID schemeID="PL:BDO">000099999</cbc:ID>
      </cac:PartyIdentification>
      <cac:PostalAddress>
        <cbc:StreetName>ul. Kwiatowa 1 m. 2</cbc:StreetName>
        <!-- Building number (NrDomu) -->
        <cbc:BuildingNumber>1</cbc:BuildingNumber>
        <cbc:CityName>Warszawa</cbc:CityName>
        <cbc:PostalZone>00-001</cbc:PostalZone>
        <cac:Country>
          <cbc:IdentificationCode>PL</cbc:IdentificationCode>
        </cac:Country>
      </cac:PostalAddress>
      <cac:PartyTaxScheme>
        <cbc:CompanyID>9999999999</cbc:CompanyID>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:PartyTaxScheme>
      <cac:PartyLegalEntity>
        <cbc:RegistrationName>ABC AGD sp. z o. o.</cbc:RegistrationName>
      </cac:PartyLegalEntity>
    </cac:Party>
    <cac:AccountingContact>
      <cbc:Telephone>667444555</cbc:Telephone>
      <cbc:ElectronicMail>abc@abc.pl</cbc:ElectronicMail>
    </cac:AccountingContact>
  </cac:AccountingSupplierParty>
  <!-- BG-7 Buyer party (Podmiot2) -->
  <cac:AccountingCustomerParty>
    <!-- Customer number (NrKlienta) -->
    <cbc:SupplierAssignedAccountID>fdfd778343</cbc:SupplierAssignedAccountID>
    <cac:Party>
      <cac:PostalAddress>
        <cbc:StreetName>ul. Sadowa 1 lok. 3</cbc:StreetName>
        <!-- Building number (NrDomu) -->
        <cbc:BuildingNumber>1</cbc:BuildingNumber>
        <cbc:CityName>Kraków</cbc:CityName>
        <cbc:PostalZone>00-002</cbc:PostalZone>
        <cac:Country>
          <cbc:IdentificationCode>PL</cbc:IdentificationCode>
        </cac:Country>
      </cac:PostalAddress>
      <cac:PartyTaxScheme>
        <cbc:CompanyID>1111111111</cbc:CompanyID>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:PartyTaxScheme>
      <cac:PartyLegalEntity>
        <cbc:RegistrationName>CDE sp. j.</cbc:RegistrationName>
      </cac:PartyLegalEntity>
    </cac:Party>
    <cac:AccountingContact>
      <cbc:Telephone>555777999</cbc:Telephone>
      <cbc:ElectronicMail>cde@cde.pl</cbc:ElectronicMail>
    </cac:AccountingContact>
  </cac:AccountingCustomerParty>
  <cac:Delivery>
    <!-- Ship-to address (WysylkaDo) and cargo description (OpisLadunku=13=Pallet) -->
    <cac:DeliveryLocation>
      <cbc:Description>13</cbc:Description>
      <cac:Address>
        <cbc:StreetName>ul. Sadowa 1 lok. 3</cbc:StreetName>
        <cbc:BuildingNumber>1</cbc:BuildingNumber>
        <cbc:CityName>Kraków</cbc:CityName>
        <cbc:PostalZone>00-002</cbc:PostalZone>
        <cac:Country>
          <cbc:IdentificationCode>PL</cbc:IdentificationCode>
        </cac:Country>
      </cac:Address>
    </cac:DeliveryLocation>
    <!-- Carrier party (Przewoznik) — name only; Przewoznik element is not output by the transform -->
    <cac:CarrierParty>
      <cac:PartyName>
        <cbc:Name>Jan Nowak Transport</cbc:Name>
      </cac:PartyName>
    </cac:CarrierParty>
    <!-- WysylkaZ (ship-from) is not supported via header-level Delivery; delivererLocation
         is only populated from line-level cac:Delivery/cac:Despatch/cac:DespatchLocation -->
    <cac:Shipment>
      <cbc:ID>1</cbc:ID>
      <cac:ShipmentStage>
        <!-- Transport mode (RodzajTransportu): 3 = Road transport -->
        <cbc:TransportModeCode>3</cbc:TransportModeCode>
      </cac:ShipmentStage>
    </cac:Shipment>
  </cac:Delivery>
  <!-- Delivery conditions / Incoterms (WarunkiDostawy) — must use SpecialTerms, not ID -->
  <cac:DeliveryTerms>
    <cbc:SpecialTerms>CIP</cbc:SpecialTerms>
  </cac:DeliveryTerms>
  <!-- Payment means (Platnosc/FormaPlatnosci=6 → bank transfer; RachunekBankowyFaktora) -->
  <cac:PaymentMeans>
    <!-- Payment means code (FormaPlatnosci=6): 42 = bank transfer -->
    <cbc:PaymentMeansCode>42</cbc:PaymentMeansCode>
    <!-- Factoring company bank account (RachunekBankowyFaktora/NrRB) -->
    <cac:PayeeFinancialAccount>
      <cbc:ID>73111111111111111111111111</cbc:ID>
      <!-- Bank account currency (OpisRachunku) -->
      <cbc:CurrencyCode>PLN</cbc:CurrencyCode>
      <cac:FinancialInstitutionBranch>
        <!-- Bank name (NazwaBanku) -->
        <cbc:Name>Bank Bankowości Bankowej S. A.</cbc:Name>
      </cac:FinancialInstitutionBranch>
    </cac:PayeeFinancialAccount>
  </cac:PaymentMeans>
  <!-- Rozliczenie: deduction block. Odliczenia/Kwota and Powod require internal settlements which PUF
       does not populate; instead use RestrictedInformation keys SumaOdliczen and DoZaplaty.
       The AllowanceCharge below is informational only and does not produce FA(3) Odliczenia output. -->
  <cac:AllowanceCharge>
    <cbc:ChargeIndicator>false</cbc:ChargeIndicator>
    <cbc:AllowanceChargeReason>nadwyżka salda nierozliczonych środków</cbc:AllowanceChargeReason>
    <cbc:Amount currencyID="PLN">1000.00</cbc:Amount>
  </cac:AllowanceCharge>
  <!-- BG-23 VAT breakdown (P_13_1 / P_14_1) -->
  <cac:TaxTotal>
    <!-- BT-110 Total VAT amount -->
    <cbc:TaxAmount currencyID="PLN">12019.82</cbc:TaxAmount>
    <cac:TaxSubtotal>
      <!-- BT-116 Net at 23% (P_13_1) -->
      <cbc:TaxableAmount currencyID="PLN">52260.10</cbc:TaxableAmount>
      <!-- BT-117 VAT at 23% (P_14_1) -->
      <cbc:TaxAmount currencyID="PLN">12019.82</cbc:TaxAmount>
      <cac:TaxCategory>
        <cbc:ID>S</cbc:ID>
        <cbc:Percent>23.00</cbc:Percent>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:TaxCategory>
    </cac:TaxSubtotal>
  </cac:TaxTotal>
  <!-- BG-22 Document totals -->
  <cac:LegalMonetaryTotal>
    <cbc:LineExtensionAmount currencyID="PLN">52260.10</cbc:LineExtensionAmount>
    <cbc:TaxExclusiveAmount currencyID="PLN">52260.10</cbc:TaxExclusiveAmount>
    <!-- BT-112 Invoice total with VAT (P_15=64279.92). PayableAmount must equal TaxInclusiveAmount
         so the transform maps P_15 correctly; DoZaplaty is sent via RestrictedInformation instead. -->
    <cbc:TaxInclusiveAmount currencyID="PLN">64279.92</cbc:TaxInclusiveAmount>
    <cbc:PayableAmount currencyID="PLN">64279.92</cbc:PayableAmount>
  </cac:LegalMonetaryTotal>
  <!-- BG-25 Invoice lines -->
  <!-- Line 1: lodówka Zimnotech mk1, delivered 2026-01-03 (P_6A), CN 8418 21 91 -->
  <cac:InvoiceLine>
    <ext:UBLExtensions>
      <ext:UBLExtension>
        <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
        <ext:ExtensionContent>
          <puf:PageroExtension>
            <puf:LineExtension>
              <!-- Universal unique line number (UU_ID) -->
              <puf:RestrictedInformation>
                <puf:Key>universalUniqueLineNumber</puf:Key>
                <puf:Value>aaaa111133339990</puf:Value>
              </puf:RestrictedInformation>
              <!-- Line subtotal (P_11) -->
              <puf:LineExclAllowanceChargeAmount currencyID="PLN">16260.10</puf:LineExclAllowanceChargeAmount>
            </puf:LineExtension>
          </puf:PageroExtension>
        </ext:ExtensionContent>
      </ext:UBLExtension>
    </ext:UBLExtensions>
    <!-- BT-126 Line number (NrWierszaFa) -->
    <cbc:ID>1</cbc:ID>
    <!-- BT-129 Invoiced quantity (P_8B). Unit of measure (P_8A) -->
    <cbc:InvoicedQuantity unitCode="EA">10</cbc:InvoicedQuantity>
    <!-- BT-131 Line net amount (P_11) -->
    <cbc:LineExtensionAmount currencyID="PLN">16260.10</cbc:LineExtensionAmount>
    <!-- Per-line delivery date (P_6A) -->
    <cac:Delivery>
      <cbc:ActualDeliveryDate>2026-01-03</cbc:ActualDeliveryDate>
    </cac:Delivery>
    <!-- Line-level tax (BT-151/BT-152) -->
    <cac:Item>
      <!-- BT-153 Item name (P_7) -->
      <cbc:Name>lodówka Zimnotech mk1</cbc:Name>
      <!-- Commodity classification (CN) -->
      <cac:CommodityClassification>
        <cbc:ItemClassificationCode listID="TSP">8418 21 91</cbc:ItemClassificationCode>
      </cac:CommodityClassification>
      <cac:ClassifiedTaxCategory>
        <cbc:ID>S</cbc:ID>
        <cbc:Percent>23</cbc:Percent>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:ClassifiedTaxCategory>
    </cac:Item>
    <cac:Price>
      <!-- BT-146 Net unit price (P_9A) -->
      <cbc:PriceAmount currencyID="PLN">1626.01</cbc:PriceAmount>
    </cac:Price>
  </cac:InvoiceLine>
  <!-- Line 2: zamrażarka Zimnotech mk2, delivered 2026-01-10 (P_6A), CN 8418 40 20, per-unit discount P_10=100 -->
  <cac:InvoiceLine>
    <ext:UBLExtensions>
      <ext:UBLExtension>
        <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
        <ext:ExtensionContent>
          <puf:PageroExtension>
            <puf:LineExtension>
              <!-- Universal unique line number (UU_ID) -->
              <puf:RestrictedInformation>
                <puf:Key>universalUniqueLineNumber</puf:Key>
                <puf:Value>aaaa111133339991</puf:Value>
              </puf:RestrictedInformation>
              <!-- Line subtotal (P_11): qty 20 × (1000 − 100) = 18000 -->
              <puf:LineExclAllowanceChargeAmount currencyID="PLN">18000.00</puf:LineExclAllowanceChargeAmount>
            </puf:LineExtension>
          </puf:PageroExtension>
        </ext:ExtensionContent>
      </ext:UBLExtension>
    </ext:UBLExtensions>
    <!-- BT-126 Line number (NrWierszaFa) -->
    <cbc:ID>2</cbc:ID>
    <!-- BT-129 Invoiced quantity (P_8B) -->
    <cbc:InvoicedQuantity unitCode="EA">20</cbc:InvoicedQuantity>
    <!-- BT-131 Line net amount (P_11): qty 20 × (1000 − 100) = 18000 -->
    <cbc:LineExtensionAmount currencyID="PLN">18000.00</cbc:LineExtensionAmount>
    <!-- Per-unit price discount (P_10=100): line-level AllowanceCharge, total amount = qty 20 × 100 = 2000
         The transform divides netAmount by quantity to derive P_10. -->
    <cac:AllowanceCharge>
      <cbc:ChargeIndicator>false</cbc:ChargeIndicator>
      <cbc:Amount currencyID="PLN">2000.00</cbc:Amount>
      <cbc:BaseAmount currencyID="PLN">20000.00</cbc:BaseAmount>
    </cac:AllowanceCharge>
    <!-- Per-line delivery date (P_6A) -->
    <cac:Delivery>
      <cbc:ActualDeliveryDate>2026-01-10</cbc:ActualDeliveryDate>
    </cac:Delivery>
    <!-- Line-level tax (BT-151/BT-152) -->
    <cac:Item>
      <!-- BT-153 Item name (P_7) -->
      <cbc:Name>zamrażarka Zimnotech mk2</cbc:Name>
      <!-- Commodity classification (CN) -->
      <cac:CommodityClassification>
        <cbc:ItemClassificationCode listID="TSP">8418 40 20</cbc:ItemClassificationCode>
      </cac:CommodityClassification>
      <cac:ClassifiedTaxCategory>
        <cbc:ID>S</cbc:ID>
        <cbc:Percent>23</cbc:Percent>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:ClassifiedTaxCategory>
    </cac:Item>
    <cac:Price>
      <!-- BT-146 Gross unit price (P_9A) -->
      <cbc:PriceAmount currencyID="PLN">1000.00</cbc:PriceAmount>
    </cac:Price>
  </cac:InvoiceLine>
  <!-- Line 3: zmywarka Bryza 100, delivered 2026-01-15 (P_6A), CN 8422 11 00 -->
  <cac:InvoiceLine>
    <ext:UBLExtensions>
      <ext:UBLExtension>
        <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
        <ext:ExtensionContent>
          <puf:PageroExtension>
            <puf:LineExtension>
              <!-- Universal unique line number (UU_ID) -->
              <puf:RestrictedInformation>
                <puf:Key>universalUniqueLineNumber</puf:Key>
                <puf:Value>aaaa111133339992</puf:Value>
              </puf:RestrictedInformation>
              <!-- Line subtotal (P_11) -->
              <puf:LineExclAllowanceChargeAmount currencyID="PLN">18000.00</puf:LineExclAllowanceChargeAmount>
            </puf:LineExtension>
          </puf:PageroExtension>
        </ext:ExtensionContent>
      </ext:UBLExtension>
    </ext:UBLExtensions>
    <!-- BT-126 Line number (NrWierszaFa) -->
    <cbc:ID>3</cbc:ID>
    <!-- BT-129 Invoiced quantity (P_8B) -->
    <cbc:InvoicedQuantity unitCode="EA">15</cbc:InvoicedQuantity>
    <!-- BT-131 Line net amount (P_11) -->
    <cbc:LineExtensionAmount currencyID="PLN">18000.00</cbc:LineExtensionAmount>
    <!-- Per-line delivery date (P_6A) -->
    <cac:Delivery>
      <cbc:ActualDeliveryDate>2026-01-15</cbc:ActualDeliveryDate>
    </cac:Delivery>
    <!-- Line-level tax (BT-151/BT-152) -->
    <cac:Item>
      <!-- BT-153 Item name (P_7) -->
      <cbc:Name>zmywarka Bryza 100</cbc:Name>
      <!-- Commodity classification (CN) -->
      <cac:CommodityClassification>
        <cbc:ItemClassificationCode listID="TSP">8422 11 00</cbc:ItemClassificationCode>
      </cac:CommodityClassification>
      <cac:ClassifiedTaxCategory>
        <cbc:ID>S</cbc:ID>
        <cbc:Percent>23</cbc:Percent>
        <cac:TaxScheme>
          <cbc:ID>VAT</cbc:ID>
        </cac:TaxScheme>
      </cac:ClassifiedTaxCategory>
    </cac:Item>
    <cac:Price>
      <!-- BT-146 Net unit price (P_9A) -->
      <cbc:PriceAmount currencyID="PLN">1200.00</cbc:PriceAmount>
    </cac:Price>
  </cac:InvoiceLine>
</Invoice>
