<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<Invoice xmlns:cac="urn:pagero:CommonAggregateComponents:1.0"
    xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
    xmlns:puf="urn:pagero:ExtensionComponent:1.0"
    xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
    xmlns="urn:pagero:PageroUniversalFormat:Invoice:1.0">
    <!--
        Values in this file are based on the KSeF FA(3) sample FA_3_Przykład_10.xml.
        ZAL advance payment invoice for apartment and additional services.
        Podmiot3 Rola=4 (F.H.U. Grażyna Kowalska, 50% share) mapped as additionalBuyer.
        WartoscZamowienia (375150) carried as header RestrictedInformation.
        Fully paid (Zaplacono=1, DataZaplaty=2026-02-15).
        ZamowienieWiersz rows mapped to InvoiceLines (order items).
        Corresponding invoice type in FA (3): ZAL.
        In applicable cases the corresponding FA XML element is mentioned in parenthesis.
    -->
    <ext:UBLExtensions>
        <!-- Place of issue (P_1M) -->
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:RestrictedInformation>
                        <puf:Key>placeOfIssue</puf:Key>
                        <puf:Value>Warszawa</puf:Value>
                    </puf:RestrictedInformation>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
        <!-- Checkout method (P_16): value 2 = false -->
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:RestrictedInformation>
                        <puf:Key>checkoutMethod</puf:Key>
                        <puf:Value>false</puf:Value>
                    </puf:RestrictedInformation>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
        <!-- Total order value (Zamowienie/WartoscZamowienia) -->
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:RestrictedInformation>
                        <puf:Key>WartoscZamowienia</puf:Key>
                        <puf:Value>375150</puf:Value>
                    </puf:RestrictedInformation>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
        <!-- Fully paid indicator and date of full payment (Platnosc/Zaplacono + DataZaplaty) -->
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:FullPaymentExtension</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:FullPaymentDetails>
                        <puf:FullPaymentIndicator>true</puf:FullPaymentIndicator>
                        <puf:DateOfFullPayment>2026-02-15</puf:DateOfFullPayment>
                    </puf:FullPaymentDetails>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
        <!-- Additional purchaser (Podmiot3, Rola=4): F.H.U. Grażyna Kowalska, 50% share -->
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformationParty</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:RestrictedInformationParty>
                        <puf:Key>additionalBuyer</puf:Key>
                        <cac:Party>
                            <cac:PostalAddress>
                                <cbc:StreetName>ul. Polna 1</cbc:StreetName>
                                <cbc:BuildingNumber>1</cbc:BuildingNumber>
                                <cbc:CityName>Warszawa</cbc:CityName>
                                <cbc:PostalZone>00-001</cbc:PostalZone>
                                <cac:Country>
                                    <cbc:IdentificationCode>PL</cbc:IdentificationCode>
                                </cac:Country>
                            </cac:PostalAddress>
                            <cac:PartyTaxScheme>
                                <cbc:CompanyID>3333333333</cbc:CompanyID>
                                <cac:TaxScheme>
                                    <cbc:ID>VAT</cbc:ID>
                                </cac:TaxScheme>
                            </cac:PartyTaxScheme>
                            <cac:PartyLegalEntity>
                                <cbc:RegistrationName>F.H.U. Grażyna Kowalska</cbc:RegistrationName>
                            </cac:PartyLegalEntity>
                            <!-- Share (Udzial): 50% -->
                            <cac:Contact>
                                <cbc:Telephone>555777999</cbc:Telephone>
                                <cbc:ElectronicMail>jan@kowalski.pl</cbc:ElectronicMail>
                                <!-- Share carried as description (Udzial=50) -->
                                <cbc:Note>Udzial:50</cbc:Note>
                            </cac:Contact>
                        </cac:Party>
                        <!-- Share percentage (Udzial=50) -->
                        <cbc:Description>50</cbc:Description>
                    </puf:RestrictedInformationParty>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
    </ext:UBLExtensions>
    <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
    <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
    <!-- BT-1 Invoice number (P_2) -->
    <cbc:ID>FZ2026/02/150</cbc:ID>
    <!-- BT-2 Invoice issue date (P_1) -->
    <cbc:IssueDate>2026-02-15</cbc:IssueDate>
    <!-- BT-3 Invoice type code (RodzajFaktury): ZAL - Advance payment invoice -->
    <cbc:InvoiceTypeCode name="ZAL">386</cbc:InvoiceTypeCode>
    <!-- BT-22 Footer note (Stopka/Informacje/StopkaFaktury) -->
    <cbc:Note>Kapiał zakładowy 5 000 000</cbc:Note>
    <!-- BT-22 Additional description (DodatkowyOpis/Klucz: wysokosć wpłaconego zadatku) -->
    <cbc:Note>wysokosć wpłaconego zadatku: 20000 zł</cbc:Note>
    <!-- BT-5 Invoice document currency (KodWaluty) -->
    <cbc:DocumentCurrencyCode>PLN</cbc:DocumentCurrencyCode>
    <!-- BG-4 Seller party (Podmiot1): ABC Developex sp. z o. o. -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <!-- Additional seller ID (REGON — Stopka/Rejestry/REGON) -->
            <cac:PartyIdentification>
                <cbc:ID schemeID="PL:REGON">999999999</cbc:ID>
            </cac:PartyIdentification>
            <!-- Additional seller ID (KRS — Stopka/Rejestry/KRS) -->
            <cac:PartyIdentification>
                <cbc:ID schemeID="PL:KRS">0000099999</cbc:ID>
            </cac:PartyIdentification>
            <!-- Additional seller ID (BDO — Stopka/Rejestry/BDO) -->
            <cac:PartyIdentification>
                <cbc:ID schemeID="PL:BDO">000099999</cbc:ID>
            </cac:PartyIdentification>
            <!-- BG-5 Seller address (Podmiot1/Adres) -->
            <cac:PostalAddress>
                <!-- BT-35 Seller street (Adres/AdresL1) -->
                <cbc:StreetName>ul. Sadowa 1 m. 3</cbc:StreetName>
                <!-- Building number (NrDomu) -->
                <cbc:BuildingNumber>1</cbc:BuildingNumber>
                <!-- BT-37 Seller city (Adres/AdresL2) -->
                <cbc:CityName>Kraków</cbc:CityName>
                <!-- BT-38 Seller post code -->
                <cbc:PostalZone>00-002</cbc:PostalZone>
                <cac:Country>
                    <!-- BT-40 Seller country code (Adres/KodKraju) -->
                    <cbc:IdentificationCode>PL</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <!-- BT-31 Seller VAT number / NIP (Podmiot1/DaneIdentyfikacyjne/NIP) -->
                <cbc:CompanyID>9999999999</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <!-- BT-27 Seller name (Podmiot1/DaneIdentyfikacyjne/Nazwa) -->
                <cbc:RegistrationName>ABC Developex sp. z o. o.</cbc:RegistrationName>
            </cac:PartyLegalEntity>
        </cac:Party>
        <cac:AccountingContact>
            <!-- BT-42 Seller telephone -->
            <cbc:Telephone>667444555</cbc:Telephone>
            <!-- BT-43 Seller email -->
            <cbc:ElectronicMail>abc@abc.pl</cbc:ElectronicMail>
        </cac:AccountingContact>
    </cac:AccountingSupplierParty>
    <!-- BG-7 Buyer party (Podmiot2): F.H.U. Jan Kowalski -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <!-- BG-8 Buyer address (Podmiot2/Adres) -->
            <cac:PostalAddress>
                <!-- BT-50 Buyer street -->
                <cbc:StreetName>ul. Polna 1</cbc:StreetName>
                <!-- Building number -->
                <cbc:BuildingNumber>1</cbc:BuildingNumber>
                <!-- BT-52 Buyer city -->
                <cbc:CityName>Warszawa</cbc:CityName>
                <!-- BT-53 Buyer post code -->
                <cbc:PostalZone>00-001</cbc:PostalZone>
                <cac:Country>
                    <!-- BT-55 Buyer country code -->
                    <cbc:IdentificationCode>PL</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <!-- BT-48 Buyer VAT number / NIP -->
                <cbc:CompanyID>1111111111</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <!-- BT-44 Buyer name -->
                <cbc:RegistrationName>F.H.U. Jan Kowalski</cbc:RegistrationName>
            </cac:PartyLegalEntity>
        </cac:Party>
        <cac:AccountingContact>
            <!-- BT-57 Buyer telephone -->
            <cbc:Telephone>555777999</cbc:Telephone>
            <!-- BT-58 Buyer email -->
            <cbc:ElectronicMail>jan@kowalski.pl</cbc:ElectronicMail>
        </cac:AccountingContact>
    </cac:AccountingCustomerParty>
    <cac:Delivery>
        <!-- BT-72 Delivery date (P_6) -->
        <cbc:ActualDeliveryDate>2026-02-15</cbc:ActualDeliveryDate>
    </cac:Delivery>
    <!--
        Payment means (Platnosc/FormaPlatnosci=6 → bank transfer (przelew) → PUF code 42).
    -->
    <cac:PaymentMeans>
        <cbc:PaymentMeansCode>42</cbc:PaymentMeansCode>
    </cac:PaymentMeans>
    <!-- BG-23 VAT breakdown (P_13_1 / P_14_1) -->
    <cac:TaxTotal>
        <!-- BT-110 Total VAT amount -->
        <cbc:TaxAmount currencyID="PLN">3739.84</cbc:TaxAmount>
        <!-- Standard 23% rate breakdown (P_13_1 / P_14_1) -->
        <cac:TaxSubtotal>
            <!-- BT-116 Tax category taxable amount (P_13_1) -->
            <cbc:TaxableAmount currencyID="PLN">16260.16</cbc:TaxableAmount>
            <!-- BT-117 Tax category tax amount (P_14_1) -->
            <cbc:TaxAmount currencyID="PLN">3739.84</cbc:TaxAmount>
            <cac:TaxCategory>
                <!-- BT-118 Tax category code -->
                <cbc:ID>S</cbc:ID>
                <!-- BT-119 Tax category rate -->
                <cbc:Percent>23.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>
    <!-- BG-22 Document totals -->
    <cac:LegalMonetaryTotal>
        <!-- BT-106 Sum of invoice line net amounts -->
        <cbc:LineExtensionAmount currencyID="PLN">16260.16</cbc:LineExtensionAmount>
        <!-- BT-109 Invoice total amount without VAT -->
        <cbc:TaxExclusiveAmount currencyID="PLN">16260.16</cbc:TaxExclusiveAmount>
        <!-- BT-112 Invoice total amount with VAT -->
        <cbc:TaxInclusiveAmount currencyID="PLN">20000.00</cbc:TaxInclusiveAmount>
        <!-- BT-115 Amount due for payment (P_15) -->
        <cbc:PayableAmount currencyID="PLN">20000.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>
    <!-- BG-25 Invoice lines (ZamowienieWiersz rows) -->
    <!-- Line 1 (NrWierszaZam=1): mieszkanie 50m^2, 23% VAT -->
    <cac:InvoiceLine>
        <ext:UBLExtensions>
            <ext:UBLExtension>
                <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
                <ext:ExtensionContent>
                    <puf:PageroExtension>
                        <puf:LineExtension>
                            <!-- Universal unique line number (UU_IDZ) -->
                            <puf:RestrictedInformation>
                                <puf:Key>universalUniqueLineNumber</puf:Key>
                                <puf:Value>aaaa111133339990</puf:Value>
                            </puf:RestrictedInformation>
                        </puf:LineExtension>
                    </puf:PageroExtension>
                </ext:ExtensionContent>
            </ext:UBLExtension>
        </ext:UBLExtensions>
        <!-- BT-126 Invoice line number (NrWierszaZam) -->
        <cbc:ID>1</cbc:ID>
        <!-- BT-129 Invoiced quantity (P_8BZ). Unit of measure (P_8AZ: szt. → EA) -->
        <cbc:InvoicedQuantity unitCode="EA">1</cbc:InvoicedQuantity>
        <!-- BT-131 Invoice line net amount (P_11NettoZ) -->
        <cbc:LineExtensionAmount currencyID="PLN">300000.00</cbc:LineExtensionAmount>
        <cac:TaxTotal>
            <!-- VAT amount for this order line (P_11VatZ) -->
            <cbc:TaxAmount currencyID="PLN">69000.00</cbc:TaxAmount>
        </cac:TaxTotal>
        <cac:Item>
            <!-- BT-153 Item name (P_7Z) -->
            <cbc:Name>mieszkanie 50m^2</cbc:Name>
            <!-- Line-level classified tax category (P_12Z=23) for ZAL lines -->
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>23</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <!-- BT-146 Item net price (P_9AZ) -->
            <cbc:PriceAmount currencyID="PLN">300000.00</cbc:PriceAmount>
        </cac:Price>
    </cac:InvoiceLine>
    <!-- Line 2 (NrWierszaZam=2): usługi dodatkowe, 23% VAT -->
    <cac:InvoiceLine>
        <ext:UBLExtensions>
            <ext:UBLExtension>
                <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LineExtension</ext:ExtensionURI>
                <ext:ExtensionContent>
                    <puf:PageroExtension>
                        <puf:LineExtension>
                            <!-- Universal unique line number (UU_IDZ) -->
                            <puf:RestrictedInformation>
                                <puf:Key>universalUniqueLineNumber</puf:Key>
                                <puf:Value>aaaa111133339991</puf:Value>
                            </puf:RestrictedInformation>
                        </puf:LineExtension>
                    </puf:PageroExtension>
                </ext:ExtensionContent>
            </ext:UBLExtension>
        </ext:UBLExtensions>
        <!-- BT-126 Invoice line number (NrWierszaZam) -->
        <cbc:ID>2</cbc:ID>
        <!-- BT-129 Invoiced quantity (P_8BZ) -->
        <cbc:InvoicedQuantity unitCode="EA">1</cbc:InvoicedQuantity>
        <!-- BT-131 Invoice line net amount (P_11NettoZ) -->
        <cbc:LineExtensionAmount currencyID="PLN">5000.00</cbc:LineExtensionAmount>
        <cac:TaxTotal>
            <!-- VAT amount for this order line (P_11VatZ) -->
            <cbc:TaxAmount currencyID="PLN">1150.00</cbc:TaxAmount>
        </cac:TaxTotal>
        <cac:Item>
            <!-- BT-153 Item name (P_7Z) -->
            <cbc:Name>usługi dodatkowe</cbc:Name>
            <!-- Line-level classified tax category (P_12Z=23) -->
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>23</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <!-- BT-146 Item net price (P_9AZ) -->
            <cbc:PriceAmount currencyID="PLN">5000.00</cbc:PriceAmount>
        </cac:Price>
    </cac:InvoiceLine>
</Invoice>
