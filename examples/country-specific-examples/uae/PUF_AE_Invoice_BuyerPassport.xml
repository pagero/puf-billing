<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
    PUF Invoice Example: Natural Person Buyer (Passport Identification)

    Use Case: A buyer who is a natural person rather than a company. The buyer's legal
              registration identifier is a passport number, so the passport issuing
              country is required in place of an issuing authority. Counterpart of the
              PINT AE example "Buyer-PAS-identifier".

    Country: United Arab Emirates
    Format: PUF (Pagero Universal Format) 2.0
    Document Type: Tax Invoice (Type 380)
    Transaction Type: BTAE-02 = 00000000 (no special transaction context)
    Target Format: Peppol PINT BIS Billing AE 1.0.4

    Scenario Description:
    Acme Trading LLC (Dubai) sells 4 executive desks at AED 750.00 each to John Doe, a
    sole trader in Abu Dhabi who is VAT-registered and reached over Peppol. Net
    AED 3,000.00 plus AED 150.00 VAT.

    Key Fields:
    - BT-44 Buyer name: the natural person's name
    - BT-47 / BTAE-16 Buyer legal registration identifier: passport number with
      @schemeID="AE:PASSPORT". The target reports it with @schemeAgencyID="PAS"
    - BTAE-19 Buyer passport issuing country: mandatory when the buyer's identifier type is
      a passport (ibr-010-ae). ISO 3166-1 alpha-2, carried on cac:PartyIdentification with
      @schemeID="AE:PASSPORT_COUNTRY". The target reports it as @schemeAgencyName
    - With a 0235 buyer electronic address, a buyer legal registration identifier needs
      its type (ibr-180-ae), which must be TL, EID, PAS or CD (ibr-183-ae)
    - BT-48 Buyer TRN: a natural person can be VAT-registered as a sole trader

    The seller-side equivalent (BTAE-15 / BTAE-18) is shown in PUF_AE_Invoice_NaturalPerson.xml.

    Reference: UAE Electronic Invoicing Guidelines V2.0 (26 October 2026), 18.2.1;
               PUF Code List PUF-008 Identification scheme United Arab Emirates;
               Peppol PINT BIS Billing AE 1.0.4
-->
<Invoice xmlns:cac="urn:pagero:CommonAggregateComponents:1.0" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" xmlns:puf="urn:pagero:ExtensionComponent:1.0" xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2" xmlns="urn:pagero:PageroUniversalFormat:Invoice:1.0">
    <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
    <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
    <cbc:ID>INV-AE-BP-2026-001</cbc:ID>
    <cbc:IssueDate>2026-04-15</cbc:IssueDate>
    <cbc:DueDate>2026-05-15</cbc:DueDate>
    <cbc:InvoiceTypeCode name="00000000">380</cbc:InvoiceTypeCode>
    <cbc:DocumentCurrencyCode>AED</cbc:DocumentCurrencyCode>
    <cac:AccountingSupplierParty>
        <cac:Party>
            <cbc:EndpointID schemeID="0235">1000000000</cbc:EndpointID>
            <cac:PartyIdentification>
                <!-- BTAE-12 Seller legal registration authority (issuer of the trade license) -->
                <cbc:ID schemeID="AE:LRA">Department of Economic Development - Dubai</cbc:ID>
            </cac:PartyIdentification>
            <cac:PostalAddress>
                <cbc:StreetName>Sheikh Zayed Road, Office 1201</cbc:StreetName>
                <cbc:CityName>Dubai</cbc:CityName>
                <cbc:CountrySubentity>DXB</cbc:CountrySubentity>
                <cac:Country>
                    <cbc:IdentificationCode>AE</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>100000000000003</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Acme Trading LLC</cbc:RegistrationName>
                <cbc:CompanyID schemeID="AE:TL">CN-1234567</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingSupplierParty>
    <cac:AccountingCustomerParty>
        <cac:Party>
            <!-- BT-49 Buyer electronic address: the buyer's 10-digit TIN under scheme 0235 -->
            <cbc:EndpointID schemeID="0235">1000000200</cbc:EndpointID>
            <!-- BTAE-19 Buyer passport issuing country (mandatory when BTAE-16 is Passport).
                 Carried on cac:PartyIdentification with schemeID="AE:PASSPORT_COUNTRY". -->
            <cac:PartyIdentification>
                <cbc:ID schemeID="AE:PASSPORT_COUNTRY">IN</cbc:ID>
            </cac:PartyIdentification>
            <cac:PostalAddress>
                <cbc:StreetName>Al Khalidiyah Street, Villa 14</cbc:StreetName>
                <cbc:CityName>Abu Dhabi</cbc:CityName>
                <cbc:CountrySubentity>AUH</cbc:CountrySubentity>
                <cac:Country>
                    <cbc:IdentificationCode>AE</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <!-- BT-48 Buyer VAT identifier: the sole trader's TRN -->
                <cbc:CompanyID>100000020002003</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <!-- BT-44 Natural-person legal name -->
                <cbc:RegistrationName>John Doe</cbc:RegistrationName>
                <!-- BT-47/BTAE-16 Passport number with @schemeID="AE:PASSPORT" -->
                <cbc:CompanyID schemeID="AE:PASSPORT">Z1234567</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingCustomerParty>
    <cac:PaymentMeans>
        <!-- BT-81 Payment means type code: 30 = Credit transfer -->
        <cbc:PaymentMeansCode>30</cbc:PaymentMeansCode>
        <cac:PayeeFinancialAccount>
            <!-- BT-84 Payment account identifier (IBAN). Mandatory when BT-81 is 30 (ibr-192-ae) -->
            <cbc:ID>AE070331234567890123456</cbc:ID>
            <cac:FinancialInstitutionBranch>
                <!-- BT-86 BIC -->
                <cbc:ID>EBILAEAD</cbc:ID>
            </cac:FinancialInstitutionBranch>
        </cac:PayeeFinancialAccount>
    </cac:PaymentMeans>
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="AED">150.00</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="AED">3000.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="AED">150.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>5.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>
    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="AED">3000.00</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="AED">3000.00</cbc:TaxExclusiveAmount>
        <cbc:TaxInclusiveAmount currencyID="AED">3150.00</cbc:TaxInclusiveAmount>
        <cbc:PayableAmount currencyID="AED">3150.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>
    <cac:InvoiceLine>
        <cbc:ID>1</cbc:ID>
        <cbc:InvoicedQuantity unitCode="EA">4</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="AED">3000.00</cbc:LineExtensionAmount>
        <!-- BTAE-08 VAT line amount in AED; BTAE-10 line amount in AED (both required per ibr-104-ae / ibr-194-ae) -->
        <cac:TaxTotal>
            <cbc:TaxAmount currencyID="AED">150.00</cbc:TaxAmount>
        </cac:TaxTotal>
        <cac:Item>
            <cbc:Description>Executive desk, solid oak, 180 x 90 cm</cbc:Description>
            <cbc:Name>Executive desk</cbc:Name>
            <cac:CommodityClassification>
                <cbc:CommodityCode>G</cbc:CommodityCode>
                <cbc:ItemClassificationCode listID="HS">9403.30.00</cbc:ItemClassificationCode>
            </cac:CommodityClassification>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>5.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="AED">750.00</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="EA">1</cbc:BaseQuantity>
            <!-- IBT-148 Item gross price (required per ibr-126-ae; 0.00 discount = gross equals net) -->
            <cac:AllowanceCharge>
                <cbc:ChargeIndicator>false</cbc:ChargeIndicator>
                <cbc:Amount currencyID="AED">0.00</cbc:Amount>
                <cbc:BaseAmount currencyID="AED">750.00</cbc:BaseAmount>
            </cac:AllowanceCharge>
        </cac:Price>
    </cac:InvoiceLine>
</Invoice>