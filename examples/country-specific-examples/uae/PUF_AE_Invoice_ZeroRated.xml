<!--
    PUF Invoice Example: Domestic Zero-Rated Supply with Document Level Allowance and Charge

    Use Case: A zero-rated supply between two UAE businesses that is not an export, with a
              document level allowance and a document level charge in category Z.
              Counterpart of the PINT AE examples "Zero rated supplies",
              "Doc-level-allowance-Z-category" and "Doc-level-charge-Z-category".

    Country: United Arab Emirates
    Format: PUF (Pagero Universal Format) 2.0
    Document Type: Tax Invoice (Type 380)
    Transaction Type: BTAE-02 = 00000000 (no special transaction context; the export flag
                      is not set because the goods stay in the UAE)
    Target Format: Peppol PINT BIS Billing AE 1.0.4

    Scenario Description:
    Acme Medical Supplies LLC (Dubai) supplies 40 packs of insulin pens at AED 220.00 each
    to Burj Healthcare LLC (Abu Dhabi). The medicines are zero rated. A 2% early payment
    discount of AED 176.00 is deducted and AED 150.00 is charged for cold-chain delivery.
    Taxable amount AED 8,774.00, VAT AED 0.00.

    Zero-rated supplies remain within the VAT framework, so they are invoiced with type
    code 380 and not 480 (Guidelines V2.0 18.3.1).

    Key Fields:
    - BT-151 / BT-95 / BT-102 / BT-118 VAT category Z with rate 0.00 at every level: line,
      document level allowance and charge, and VAT breakdown (aligned-ibrp-z-05,
      aligned-ibrp-z-06, aligned-ibrp-z-07, ibr-120-ae)
    - BT-116 Z taxable amount = Z line net amounts - Z allowances + Z charges
      (aligned-ibrp-z-08)
    - BTAE-08 Line VAT amount: zero on a zero-rated line (ibr-165-ae)
    - BG-21 Document level charge: reason code DL (Delivery)

    Reference: UAE Electronic Invoicing Guidelines V2.0 (26 October 2026), 18.3.1;
               Peppol PINT BIS Billing AE 1.0.4
-->
<Invoice xmlns:cac="urn:pagero:CommonAggregateComponents:1.0" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" xmlns:puf="urn:pagero:ExtensionComponent:1.0" xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2" xmlns="urn:pagero:PageroUniversalFormat:Invoice:1.0">
    <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
    <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
    <cbc:ID>INV-AE-ZR-2026-001</cbc:ID>
    <cbc:IssueDate>2026-04-15</cbc:IssueDate>
    <cbc:DueDate>2026-05-15</cbc:DueDate>
    <cbc:InvoiceTypeCode name="00000000">380</cbc:InvoiceTypeCode>
    <cbc:DocumentCurrencyCode>AED</cbc:DocumentCurrencyCode>
    <cac:AccountingSupplierParty>
        <cac:Party>
            <cbc:EndpointID schemeID="0235">1000000000</cbc:EndpointID>
            <cac:PartyIdentification>
                <!-- BTAE-12 Seller legal registration authority (issuer of the trade license) -->
                <cbc:ID schemeID="AE:LRA">Department of Economic Development - Dubai</cbc:ID>
            </cac:PartyIdentification>
            <cac:PostalAddress>
                <cbc:StreetName>Dubai Healthcare City, Building 27</cbc:StreetName>
                <cbc:CityName>Dubai</cbc:CityName>
                <cbc:CountrySubentity>DXB</cbc:CountrySubentity>
                <cac:Country>
                    <cbc:IdentificationCode>AE</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>100000000000003</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Acme Medical Supplies LLC</cbc:RegistrationName>
                <cbc:CompanyID schemeID="AE:TL">CN-1234567</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingSupplierParty>
    <cac:AccountingCustomerParty>
        <cac:Party>
            <cbc:EndpointID schemeID="0235">1000000100</cbc:EndpointID>
            <cac:PartyIdentification>
                <!-- BTAE-11 Buyer legal registration authority (issuer of the trade license) -->
                <cbc:ID schemeID="AE:LRA">Abu Dhabi Department of Economic Development</cbc:ID>
            </cac:PartyIdentification>
            <cac:PostalAddress>
                <cbc:StreetName>Khalifa Street, Tower 5</cbc:StreetName>
                <cbc:CityName>Abu Dhabi</cbc:CityName>
                <cbc:CountrySubentity>AUH</cbc:CountrySubentity>
                <cac:Country>
                    <cbc:IdentificationCode>AE</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>100000010001003</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Burj Healthcare LLC</cbc:RegistrationName>
                <cbc:CompanyID schemeID="AE:TL">CN-1001003</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingCustomerParty>
    <cac:PaymentMeans>
        <!-- BT-81 Payment means type code: 30 = Credit transfer -->
        <cbc:PaymentMeansCode>30</cbc:PaymentMeansCode>
        <cac:PayeeFinancialAccount>
            <!-- BT-84 Payment account identifier (IBAN). Mandatory when BT-81 is 30 (ibr-192-ae) -->
            <cbc:ID>AE070331234567890123456</cbc:ID>
            <cac:FinancialInstitutionBranch>
                <!-- BT-86 BIC -->
                <cbc:ID>EBILAEAD</cbc:ID>
            </cac:FinancialInstitutionBranch>
        </cac:PayeeFinancialAccount>
    </cac:PaymentMeans>
    <!-- BG-20 Document level allowance in category Z: rate 0.00 (aligned-ibrp-z-06) -->
    <cac:AllowanceCharge>
        <cbc:ChargeIndicator>false</cbc:ChargeIndicator>
        <cbc:AllowanceChargeReasonCode>95</cbc:AllowanceChargeReasonCode>
        <cbc:AllowanceChargeReason>Early payment discount</cbc:AllowanceChargeReason>
        <!-- BT-94 Percentage; BT-92 amount = BT-93 base amount x BT-94 / 100 (ibr-131-ae) -->
        <cbc:MultiplierFactorNumeric>2</cbc:MultiplierFactorNumeric>
        <cbc:Amount currencyID="AED">176.00</cbc:Amount>
        <cbc:BaseAmount currencyID="AED">8800.00</cbc:BaseAmount>
        <cac:TaxCategory>
            <cbc:ID>Z</cbc:ID>
            <cbc:Percent>0.00</cbc:Percent>
            <cac:TaxScheme>
                <cbc:ID>VAT</cbc:ID>
            </cac:TaxScheme>
        </cac:TaxCategory>
    </cac:AllowanceCharge>
    <!-- BG-21 Document level charge in category Z: rate 0.00 (aligned-ibrp-z-07) -->
    <cac:AllowanceCharge>
        <cbc:ChargeIndicator>true</cbc:ChargeIndicator>
        <cbc:AllowanceChargeReasonCode>DL</cbc:AllowanceChargeReasonCode>
        <cbc:AllowanceChargeReason>Cold-chain delivery</cbc:AllowanceChargeReason>
        <cbc:Amount currencyID="AED">150.00</cbc:Amount>
        <cac:TaxCategory>
            <cbc:ID>Z</cbc:ID>
            <cbc:Percent>0.00</cbc:Percent>
            <cac:TaxScheme>
                <cbc:ID>VAT</cbc:ID>
            </cac:TaxScheme>
        </cac:TaxCategory>
    </cac:AllowanceCharge>
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="AED">0.00</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <!-- BT-116 = line net 8,800.00 - allowance 176.00 + charge 150.00 (aligned-ibrp-z-08) -->
            <cbc:TaxableAmount currencyID="AED">8774.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="AED">0.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>Z</cbc:ID>
                <cbc:Percent>0.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>
    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="AED">8800.00</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="AED">8774.00</cbc:TaxExclusiveAmount>
        <cbc:TaxInclusiveAmount currencyID="AED">8774.00</cbc:TaxInclusiveAmount>
        <cbc:AllowanceTotalAmount currencyID="AED">176.00</cbc:AllowanceTotalAmount>
        <cbc:ChargeTotalAmount currencyID="AED">150.00</cbc:ChargeTotalAmount>
        <cbc:PayableAmount currencyID="AED">8774.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>
    <cac:InvoiceLine>
        <cbc:ID>1</cbc:ID>
        <cbc:InvoicedQuantity unitCode="EA">40</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="AED">8800.00</cbc:LineExtensionAmount>
        <!-- BTAE-08 VAT line amount: zero on a zero-rated line (ibr-165-ae) -->
        <cac:TaxTotal>
            <cbc:TaxAmount currencyID="AED">0.00</cbc:TaxAmount>
        </cac:TaxTotal>
        <cac:Item>
            <cbc:Description>Insulin glargine 100 units/ml, pre-filled pen, pack of 5</cbc:Description>
            <cbc:Name>Insulin pens</cbc:Name>
            <cac:CommodityClassification>
                <cbc:CommodityCode>G</cbc:CommodityCode>
                <cbc:ItemClassificationCode listID="HS">3004.31.00</cbc:ItemClassificationCode>
            </cac:CommodityClassification>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>Z</cbc:ID>
                <cbc:Percent>0.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="AED">220.00</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="EA">1</cbc:BaseQuantity>
            <!-- IBT-148 Item gross price (required per ibr-126-ae; 0.00 discount = gross equals net) -->
            <cac:AllowanceCharge>
                <cbc:ChargeIndicator>false</cbc:ChargeIndicator>
                <cbc:Amount currencyID="AED">0.00</cbc:Amount>
                <cbc:BaseAmount currencyID="AED">220.00</cbc:BaseAmount>
            </cac:AllowanceCharge>
        </cac:Price>
    </cac:InvoiceLine>
</Invoice>