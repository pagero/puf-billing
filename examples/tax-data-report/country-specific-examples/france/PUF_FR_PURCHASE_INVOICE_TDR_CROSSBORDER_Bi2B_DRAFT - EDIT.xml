<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<Invoice xmlns:cac="urn:pagero:CommonAggregateComponents:1.0"
    xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
    xmlns="urn:pagero:PageroUniversalFormat:Invoice:1.0" xmlns:puf="urn:pagero:ExtensionComponent:1.0" xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2">


    <!-- Example of an EDIT (Modification/MO) scenario: corrects one specific document in an already-Approved period.
         Corrects the base PUF_FR_PURCHASE_INVOICE_TDR_CROSSBORDER_Bi2B_DRAFT.xml (taxReportId "The id for the
         report"): its invoice reported InvoicedQuantity=100, but 20 units were omitted from the original count. -->
    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <!-- Indication of type of taxreporting (can be INVOICE or RECEIPTTRANSACTION) -->
                    <puf:RestrictedInformation>
                        <puf:Key>entryType</puf:Key>
                        <puf:Value>INVOICE</puf:Value>
                    </puf:RestrictedInformation>
                    <!-- if a issuer wants to send a issuerAssignedReportId -->
                    <puf:RestrictedInformation>
                        <puf:Key>issuerAssignedReportId</puf:Key>
                        <puf:Value>Issuer assigned report id</puf:Value>
                    </puf:RestrictedInformation>
                    <!-- In an EDIT scenario: the period MUST be the same as the period of the document being corrected -->
                    <puf:RestrictedInformation>
                        <puf:Key>reportPeriodStart</puf:Key>
                        <puf:Value>2025-02-01</puf:Value>
                    </puf:RestrictedInformation>
                    <puf:RestrictedInformation>
                        <puf:Key>reportPeriodEnd</puf:Key>
                        <puf:Value>2025-02-28</puf:Value>
                    </puf:RestrictedInformation>
                    <!-- EDIT: correction of one specific document already reported and Approved for the period. NOTE only
                         the corrected document is sent - every other already-reported document is unaffected and not resent. -->
                    <puf:RestrictedInformation>
                        <puf:Key>transmissionType</puf:Key>
                        <puf:Value>EDIT</puf:Value>
                    </puf:RestrictedInformation>
                    <!-- Tax report id -> taxReport/taxReportId -->
                    <puf:RestrictedInformation>
                        <puf:Key>taxReportId</puf:Key>
                        <puf:Value>The id for the EDIT-REPORT</puf:Value>
                    </puf:RestrictedInformation>
                    <!-- In an EDIT scenario: Reference to the specific previously sent tax report document being
                         corrected - its own taxReportId ("The id for the report"), NOT the id of an aggregated
                         report (see the "- ADD.xml" and "- RECTIFICATION.xml" siblings, which reference an
                         aggregatedId instead). -->
                    <puf:RestrictedInformation>
                        <puf:Key>referencedReportId</puf:Key>
                        <puf:Value>The id for the report</puf:Value>
                    </puf:RestrictedInformation>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
    </ext:UBLExtensions>

    <!-- BT-24 Specification identifier -->
    <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
    <!-- BT-23 Business process type -->
    <cbc:ProfileID>urn:pagero.com:puf:purchase:1.0</cbc:ProfileID>
    <!-- BT-1 Invoice Number - same invoice as the original ("The id for the report") submission -->
    <cbc:ID>INV123456</cbc:ID>
    <!-- BT-2 Invoice Issue Date - unchanged from the original -->
    <cbc:IssueDate>2026-01-01</cbc:IssueDate>
    <!-- BT-9 Due Date - unchanged from the original -->
    <cbc:DueDate>2026-01-31</cbc:DueDate>
    <!-- BT-3 Invoice Type Code, in attribute @name the business process. -->
    <cbc:InvoiceTypeCode name="B1">380</cbc:InvoiceTypeCode>
    <!-- BT-22 - Invoice note. BT-21 note type between ## -->
    <cbc:Note>#AAA#Module électronique programmable pour applications technologiques avancées, doté de microprocesseurs haute performance, d’une mémoire embarquée de 16 Go, et d’interfaces multiples (USB, Ethernet, et GPIO). Correction: 20 unités omises du décompte initial (120 au lieu de 100).</cbc:Note>
    <!-- BT-5 Invoice Document Currency -->
    <cbc:DocumentCurrencyCode>EUR</cbc:DocumentCurrencyCode>
    <!-- BG-14 Invoicing Period - unchanged from the original -->
    <cac:InvoicePeriod>
        <!-- BT-73 - Invoicing period start date -->
        <cbc:StartDate>2025-12-01</cbc:StartDate>
        <!-- BT-74 - Invoicing period end date -->
        <cbc:EndDate>2026-01-31</cbc:EndDate>
        <!-- BT-8 - TAX point date code. UNCL2005 subset: 3 (invoice issue date), 35 (delivery date), 432 (paid to date) -->
        <cbc:DescriptionCode>3</cbc:DescriptionCode>
    </cac:InvoicePeriod>
    <!-- BG-4 Seller - unchanged from the original -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <cac:PostalAddress>
                <cac:Country>
                    <!-- BT-40 Seller address country code -->
                    <cbc:IdentificationCode>DE</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <!-- BT-31 Seller TAX Number -->
                <cbc:CompanyID>DE00123123123</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <!-- BT-27 Seller Name -->
                <cbc:RegistrationName>Seller company Name</cbc:RegistrationName>
                <!-- BT-30 Seller legal registration identifier -->
                <cbc:CompanyID schemeID="0223">123123123</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingSupplierParty>
    <!-- BG-7 Buyer - unchanged from the original -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <cac:PostalAddress>
                <cac:Country>
                    <!-- BT-55 Buyer address country code -->
                    <cbc:IdentificationCode>FR</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <!-- BT-48 Buyer TAX Number -->
                <cbc:CompanyID>FR00323456789</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <!-- BT-44 Buyer Name -->
                <cbc:RegistrationName>Buyer Company Name</cbc:RegistrationName>
                <!-- BT-47 Buyer legal registration identifier. -->
                <cbc:CompanyID schemeID="0002">323456789</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingCustomerParty>
    <cac:Delivery>
        <!-- BT-72 Delivery date - unchanged from the original -->
        <cbc:ActualDeliveryDate>2026-01-01</cbc:ActualDeliveryDate>
        <!-- BG-15 Delivery location/deliver to address -->
        <cac:DeliveryLocation>
            <cac:Address>
                <!-- BT-75 Deliver to street name-->
                <cbc:StreetName>ZAC du Cornillon Nord</cbc:StreetName>
                <!-- BT-77 Deliver to city -->
                <cbc:CityName>Saint-Denis</cbc:CityName>
                <!-- BT-78 Deliver to post code-->
                <cbc:PostalZone>93216</cbc:PostalZone>
                <cac:Country>
                    <!-- BT-80 Deliver to post code -->
                    <cbc:IdentificationCode>FR</cbc:IdentificationCode>
                </cac:Country>
            </cac:Address>
        </cac:DeliveryLocation>
    </cac:Delivery>
    <!-- Corrected quantity: original reported 100 units (2000.00 EUR net / 400.00 EUR VAT);
         corrected to 120 units (2400.00 EUR net / 480.00 EUR VAT), same 20.00 EUR/unit price and 20% rate. -->
    <cac:TaxTotal>
        <!-- BT-110 Invoice total TAX amount. Currency in attribute currencyID (BT-5) -->
        <cbc:TaxAmount currencyID="EUR">480.00</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <!-- BT-116 Sum of all taxable amounts subject to a specific TAX category code and TAX category rate. Currency in attribute currencyID (BT-5) -->
            <cbc:TaxableAmount currencyID="EUR">2400.00</cbc:TaxableAmount>
            <!--  BT-117. The total TAX amount for a given TAX category. Currency in attribute currencyID (BT-5) -->
            <cbc:TaxAmount currencyID="EUR">480.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <!-- BT-118 TAX category code. -->
                <cbc:ID>S</cbc:ID>
                <!-- BT-119 TAX category rate-->
                <cbc:Percent>20</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>
    <cac:LegalMonetaryTotal>
        <!-- BT-109 Invoice total amount without TAX. Currency in attribute currencyID (BT-5)-->
        <cbc:TaxExclusiveAmount currencyID="EUR">2400.00</cbc:TaxExclusiveAmount>
       <!-- BT-115 Amount due for payment. Currency in attribute currencyID (BT-5) -->
        <cbc:PayableAmount currencyID="EUR">2400.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>
    <cac:InvoiceLine>
        <!-- BT-126 Line ID -->
        <cbc:ID>1</cbc:ID>
        <!-- BT-129 Invoiced Quantity - corrected from 100 to 120. BT-130 unit of measure in attribute unitCode -->
        <cbc:InvoicedQuantity unitCode="NAR">120</cbc:InvoicedQuantity>
        <!-- BT-131 Line extension amount - corrected from 2000.00 to 2400.00. Currency in attribute currencyID (BT-5) -->
        <cbc:LineExtensionAmount currencyID="EUR">2400.00</cbc:LineExtensionAmount>
        <cac:Item>
            <!-- BT-153 Item name -->
            <cbc:Name>Livraison de modules</cbc:Name>
            <!-- BG-30 LINE TAX INFORMATION -->
            <cac:ClassifiedTaxCategory>
                <!-- BT-151 Invoiced item TAX category code -->
                <cbc:ID>S</cbc:ID>
                <!-- BT-152 Invoiced item TAX rate -->
                <cbc:Percent>20</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <!-- BG-29 PRICE DETAILS -->
        <cac:Price>
            <!-- BT-146 Item net price - unchanged from the original. Currency in attribute currencyID (BT-5) -->
            <cbc:PriceAmount currencyID="EUR">20.00</cbc:PriceAmount>
        </cac:Price>
    </cac:InvoiceLine>
</Invoice>
