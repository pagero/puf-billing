<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<Invoice xmlns:cac="urn:pagero:CommonAggregateComponents:1.0"
         xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
         xmlns:puf="urn:pagero:ExtensionComponent:1.0"
         xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
         xmlns="urn:pagero:PageroUniversalFormat:Invoice:1.0">

    <!-- Values in invoice are example values only. 
         Example of reporting a sales invoice in Singapore with dual currency for tax data reporting.
         Invoice issued in USD (foreign currency) with tax reported in SGD (local currency).
         Exchange rate USD to SGD = 1.35. Sent outside Peppol network. DRAFT -->

    <!-- Entry type. Type can be INVOICE or RECEIPTTRANSACTION -->
    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:RestrictedInformation</ext:ExtensionURI>
            <ext:ExtensionContent>
                <puf:PageroExtension>
                    <puf:RestrictedInformation>
                        <puf:Key>entryType</puf:Key>
                        <puf:Value>INVOICE</puf:Value>
                    </puf:RestrictedInformation>
                </puf:PageroExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
    </ext:UBLExtensions>

    <!-- IBT-024 Specification identifier -->
    <cbc:CustomizationID>urn:pagero.com:puf:billing:2.0</cbc:CustomizationID>
    <!-- IBT-023 Business process type -->
    <cbc:ProfileID>urn:pagero.com:puf:billing:1.0</cbc:ProfileID>
    <!-- IBT-001 Invoice Number -->
    <cbc:ID>SG-DC-INV-2025-001</cbc:ID>
    <!-- BT-SG-003 An identifier that uniquely identifies the invoice document -->
    <cbc:UUID>a1b2c3d4-e5f6-7890-abcd-ef1234567890</cbc:UUID>
    <!-- IBT-002 Invoice Issue Date -->
    <cbc:IssueDate>2025-03-15</cbc:IssueDate>
    <!-- IBT-009 Due Date -->
    <cbc:DueDate>2025-04-15</cbc:DueDate>
    <!-- IBT-003 Invoice Type Code -->
    <cbc:InvoiceTypeCode>380</cbc:InvoiceTypeCode>
    <!-- IBT-005 Invoice Document Currency (foreign currency) -->
    <cbc:DocumentCurrencyCode>USD</cbc:DocumentCurrencyCode>
    <!-- IBT-006 Tax Currency Code (local Singapore currency for tax reporting) -->
    <cbc:TaxCurrencyCode>SGD</cbc:TaxCurrencyCode>
    <!-- IBT-010 Buyer reference -->
    <cbc:BuyerReference>BUYER-REF-001</cbc:BuyerReference>
    <cac:OrderReference>
        <!-- IBT-013 Purchase order reference -->
        <cbc:ID>PO-2025-0042</cbc:ID>
    </cac:OrderReference>
    <!-- IBG-04 Seller -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <!-- Supplier's Peppol ID -->
            <cbc:EndpointID schemeID="0195">SGUEN1234567891</cbc:EndpointID>
            <!-- IBT-028 Trading name -->
            <cac:PartyName>
                <cbc:Name>Singapore Export Trading Pte Ltd</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <!-- IBT-035 Seller address street -->
                <cbc:StreetName>1 Raffles Place</cbc:StreetName>
                <!-- IBT-037 Seller address City -->
                <cbc:CityName>Singapore</cbc:CityName>
                <!-- IBT-038 Seller address postal code -->
                <cbc:PostalZone>048616</cbc:PostalZone>
                <cac:Country>
                    <!-- IBT-040 Seller address country code -->
                    <cbc:IdentificationCode>SG</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <!-- IBT-031 Supplier's GST Registration Number -->
                <cbc:CompanyID>M12345678A</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>GST</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <!-- IBT-027 Seller Name -->
                <cbc:RegistrationName>Singapore Export Trading Pte Ltd</cbc:RegistrationName>
                <!-- IBT-030 Supplier's UEN -->
                <cbc:CompanyID schemeID="0195">201812345A</cbc:CompanyID>
            </cac:PartyLegalEntity>
            <!-- IBG-6 SELLER CONTACT -->
            <cac:Contact>
                <!-- IBT-041 Seller contact point -->
                <cbc:Name>Accounting Department</cbc:Name>
                <!-- IBT-043 Seller contact email address -->
                <cbc:ElectronicMail>accounts@sgexport.com.sg</cbc:ElectronicMail>
            </cac:Contact>
        </cac:Party>
    </cac:AccountingSupplierParty>
    <!-- IBG-07 Buyer -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <!-- C5UIDYYYYYYYYYY (C5UID = C5 UserID YYYYYYYYYY = Customer's UEN) -->
            <cbc:EndpointID schemeID="0195">C5UID9876543210</cbc:EndpointID>
            <!-- IBT-045 Trading Name -->
            <cac:PartyName>
                <cbc:Name>US Imports Inc</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <!-- IBT-050 Buyer address street -->
                <cbc:StreetName>100 Broadway</cbc:StreetName>
                <!-- IBT-052 Buyer address City -->
                <cbc:CityName>New York</cbc:CityName>
                <!-- IBT-053 Buyer address postal code -->
                <cbc:PostalZone>10005</cbc:PostalZone>
                <!-- IBT-054 Buyer address province/state -->
                <cbc:CountrySubentity>NY</cbc:CountrySubentity>
                <cac:Country>
                    <!-- IBT-055 Buyer address country code -->
                    <cbc:IdentificationCode>US</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyLegalEntity>
                <!-- IBT-044 Buyer Name -->
                <cbc:RegistrationName>US Imports Inc</cbc:RegistrationName>
                <!-- IBT-047 Buyer legal registration identifier -->
                <cbc:CompanyID>US-EIN-123456789</cbc:CompanyID>
            </cac:PartyLegalEntity>
            <!-- BG-09 BUYER CONTACT -->
            <cac:Contact>
                <!-- IBT-056 Buyer contact point -->
                <cbc:Name>Jane Smith</cbc:Name>
                <!-- IBT-058 Buyer contact email address -->
                <cbc:ElectronicMail>jane.smith@usimports.com</cbc:ElectronicMail>
            </cac:Contact>
        </cac:Party>
    </cac:AccountingCustomerParty>
    <cac:PaymentMeans>
        <!-- IBT-081 Payment means code -->
        <cbc:PaymentMeansCode>30</cbc:PaymentMeansCode>
        <cac:PayeeFinancialAccount>
            <!-- IBT-084 Payment account identifier -->
            <cbc:ID>SG1234567890123</cbc:ID>
            <cac:FinancialInstitutionBranch>
                <!-- IBT-086 Swift/BIC -->
                <cbc:ID>DBSSSGSG</cbc:ID>
            </cac:FinancialInstitutionBranch>
        </cac:PayeeFinancialAccount>
    </cac:PaymentMeans>
    <!-- Tax exchange rate: USD -> SGD -->
    <cac:TaxExchangeRate>
        <cbc:SourceCurrencyCode>USD</cbc:SourceCurrencyCode>
        <cbc:TargetCurrencyCode>SGD</cbc:TargetCurrencyCode>
        <cbc:CalculationRate>1.35</cbc:CalculationRate>
        <cbc:MathematicOperatorCode>Multiply</cbc:MathematicOperatorCode>
    </cac:TaxExchangeRate>
    <cac:TaxTotal>
        <!-- IBT-110 Invoice total TAX amount in document currency (IBT-005 = USD) -->
        <cbc:TaxAmount currencyID="USD">270.00</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <ext:UBLExtensions>
                <ext:UBLExtension>
                    <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:TaxSubtotalExtension</ext:ExtensionURI>
                    <ext:ExtensionContent>
                        <puf:PageroExtension>
                            <puf:TaxSubtotalExtension>
                                <!-- Tax amounts converted to SGD (tax currency) -->
                                <puf:TaxCurrencyTaxableAmount currencyID="SGD">4050.00</puf:TaxCurrencyTaxableAmount>
                                <puf:TaxCurrencyTaxAmount currencyID="SGD">364.50</puf:TaxCurrencyTaxAmount>
                            </puf:TaxSubtotalExtension>
                        </puf:PageroExtension>
                    </ext:ExtensionContent>
                </ext:UBLExtension>
            </ext:UBLExtensions>
            <!-- IBT-116 Taxable amount in document currency (USD) -->
            <cbc:TaxableAmount currencyID="USD">3000.00</cbc:TaxableAmount>
            <!-- IBT-117 Tax amount in document currency (USD) -->
            <cbc:TaxAmount currencyID="USD">270.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <!-- IBT-118 TAX category code -->
                <cbc:ID>SR</cbc:ID>
                <!-- IBT-119 TAX category rate (9% GST) -->
                <cbc:Percent>9.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>GST</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>
    <!-- IBT-111 Invoice total TAX amount in tax/accounting currency (IBT-006 = SGD) -->
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="SGD">364.50</cbc:TaxAmount>
    </cac:TaxTotal>
    <cac:LegalMonetaryTotal>
        <ext:UBLExtensions>
            <ext:UBLExtension>
                <ext:ExtensionURI>urn:pagero:ExtensionComponent:1.0:PageroExtension:LegalMonetaryTotalExtension</ext:ExtensionURI>
                <ext:ExtensionContent>
                    <puf:PageroExtension>
                        <puf:LegalMonetaryTotalExtension>
                            <!-- Invoice total amount without TAX in tax currency (SGD) -->
                            <puf:TaxCurrencyTaxExclusiveAmount currencyID="SGD">4050.00</puf:TaxCurrencyTaxExclusiveAmount>
                            <!-- Invoice total amount with TAX in tax currency (SGD) -->
                            <puf:TaxCurrencyTaxInclusiveAmount currencyID="SGD">4414.50</puf:TaxCurrencyTaxInclusiveAmount>
                        </puf:LegalMonetaryTotalExtension>
                    </puf:PageroExtension>
                </ext:ExtensionContent>
            </ext:UBLExtension>
        </ext:UBLExtensions>
        <!-- IBT-106 Sum of all Invoice line net amounts without TAX (USD) -->
        <cbc:LineExtensionAmount currencyID="USD">3000.00</cbc:LineExtensionAmount>
        <!-- IBT-109 Invoice total amount without TAX (USD) -->
        <cbc:TaxExclusiveAmount currencyID="USD">3000.00</cbc:TaxExclusiveAmount>
        <!-- IBT-112 Invoice total amount with TAX (USD) -->
        <cbc:TaxInclusiveAmount currencyID="USD">3270.00</cbc:TaxInclusiveAmount>
        <!-- IBT-115 Amount due for payment (USD) -->
        <cbc:PayableAmount currencyID="USD">3270.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>
    <cac:InvoiceLine>
        <!-- IBT-126 Line ID -->
        <cbc:ID>1</cbc:ID>
        <!-- IBT-129 Invoiced Quantity. IBT-130 unit of measure -->
        <cbc:InvoicedQuantity unitCode="C62">10</cbc:InvoicedQuantity>
        <!-- IBT-131 Line extension amount (USD) -->
        <cbc:LineExtensionAmount currencyID="USD">2000.00</cbc:LineExtensionAmount>
        <cac:Item>
            <!-- IBT-154 Item description -->
            <cbc:Description>High-precision electronic components for industrial automation</cbc:Description>
            <!-- IBT-153 Item name -->
            <cbc:Name>Electronic Component Module A</cbc:Name>
            <!-- BG-30 LINE TAX INFORMATION -->
            <cac:ClassifiedTaxCategory>
                <!-- IBT-151 Invoiced item TAX category code -->
                <cbc:ID>SR</cbc:ID>
                <!-- IBT-152 Invoiced item TAX rate -->
                <cbc:Percent>9.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>GST</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <!-- IBG-29 PRICE DETAILS -->
        <cac:Price>
            <!-- IBT-146 Item net price (USD) -->
            <cbc:PriceAmount currencyID="USD">200.00</cbc:PriceAmount>
        </cac:Price>
    </cac:InvoiceLine>
    <cac:InvoiceLine>
        <!-- IBT-126 Line ID -->
        <cbc:ID>2</cbc:ID>
        <!-- IBT-129 Invoiced Quantity -->
        <cbc:InvoicedQuantity unitCode="C62">5</cbc:InvoicedQuantity>
        <!-- IBT-131 Line extension amount (USD) -->
        <cbc:LineExtensionAmount currencyID="USD">1000.00</cbc:LineExtensionAmount>
        <cac:Item>
            <!-- IBT-154 Item description -->
            <cbc:Description>Connector cables for Module A integration</cbc:Description>
            <!-- IBT-153 Item name -->
            <cbc:Name>Integration Cable Set B</cbc:Name>
            <!-- BG-30 LINE TAX INFORMATION -->
            <cac:ClassifiedTaxCategory>
                <!-- IBT-151 Invoiced item TAX category code -->
                <cbc:ID>SR</cbc:ID>
                <!-- IBT-152 Invoiced item TAX rate -->
                <cbc:Percent>9.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>GST</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <!-- IBG-29 PRICE DETAILS -->
        <cac:Price>
            <!-- IBT-146 Item net price (USD) -->
            <cbc:PriceAmount currencyID="USD">200.00</cbc:PriceAmount>
        </cac:Price>
    </cac:InvoiceLine>
</Invoice>
